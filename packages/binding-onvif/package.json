{
    "name": "@wot-av/binding-onvif",
    "version": "0.1.0-dev.0",
    "private": true,
    "description": "Private native ONVIF SOAP binding, locked-source catalog and pure WoT projection",
    "type": "commonjs",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "onvif-bridge": "dist/cli/main.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./catalog": {
            "types": "./dist/catalog/index.d.ts",
            "require": "./dist/catalog/index.js",
            "default": "./dist/catalog/index.js"
        },
        "./projection": {
            "types": "./dist/projection/index.d.ts",
            "require": "./dist/projection/index.js",
            "default": "./dist/projection/index.js"
        },
        "./binding/request": {
            "types": "./dist/binding/request.d.ts",
            "require": "./dist/binding/request.js",
            "default": "./dist/binding/request.js"
        },
        "./xml/metadata": {
            "types": "./dist/xml/metadata.d.ts",
            "require": "./dist/xml/metadata.js",
            "default": "./dist/xml/metadata.js"
        },
        "./events": {
            "types": "./dist/events/index.d.ts",
            "require": "./dist/events/index.js",
            "default": "./dist/events/index.js"
        },
        "./media": {
            "types": "./dist/media/index.d.ts",
            "require": "./dist/media/index.js",
            "default": "./dist/media/index.js"
        },
        "./discovery": {
            "types": "./dist/discovery/index.d.ts",
            "require": "./dist/discovery/index.js",
            "default": "./dist/discovery/index.js"
        },
        "./publication": {
            "types": "./dist/publication/index.d.ts",
            "require": "./dist/publication/index.js",
            "default": "./dist/publication/index.js"
        },
        "./artifacts/*": "./dist/catalog-data/*",
        "./source-documents/*": "./dist/source-documents/*",
        "./package-provenance.json": "./dist/package-provenance.json"
    },
    "files": [
        "dist",
        "NOTICE.md"
    ],
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "compile": "tsc -p tsconfig.json",
        "build": "npm run compile && node dist/catalog/stage.js && node ../../tools/stage-onvif-package.cjs",
        "prepack": "npm run build",
        "pretest": "npm run build",
        "test": "node test/run.cjs",
        "pretest:unit": "npm run build",
        "test:unit": "node test/run.cjs unit",
        "pretest:binding-gate": "npm run build",
        "test:binding-gate": "node test/run.cjs binding-gate",
        "pretest:catalog": "npm run build",
        "test:catalog": "node test/run.cjs catalog",
        "pretest:events": "npm run build",
        "test:events": "node test/run.cjs events",
        "pretest:discovery": "npm run build",
        "test:discovery": "node test/run.cjs discovery",
        "pretest:publication": "npm run build",
        "test:publication": "node test/run.cjs publication",
        "pretest:integration": "npm run build",
        "test:integration": "node test/run.cjs integration",
        "pretest:media": "npm run build",
        "test:media": "node test/run.cjs media",
        "pretest:media:native": "npm run build",
        "test:media:native": "node test/run.cjs media-native"
    },
    "dependencies": {
        "@node-wot/binding-http": "0.9.2",
        "@node-wot/core": "0.9.2",
        "node-fetch": "2.7.0",
        "rxjs": "5.5.12",
        "saxes": "6.0.0",
        "wot-typescript-definitions": "0.8.0-SNAPSHOT.31"
    },
    "devDependencies": {
        "@types/node": "22.19.0",
        "@types/node-fetch": "2.6.13",
        "@xmldom/xmldom": "0.8.15",
        "selfsigned": "2.4.1",
        "soap": "1.12.0",
        "typescript": "5.9.3"
    }
}

{
    "name": "wot-av-extension-workspace",
    "private": true,
    "workspaces": [
        "onvif/samples/reference-runtime",
        "av/tools/publication",
        "onvif/samples/adapters"
    ],
    "engines": {
        "node": ">=20.19.0"
    },
    "puppeteer": {
        "skipDownload": true
    },
    "scripts": {
        "build:specs": "node av/tools/publication/build-specs.mjs",
        "check:specs": "node av/tools/publication/build-specs.mjs --check",
        "test:specs": "npm test --workspace @wot-av/publication",
        "test:adapters": "npm test --workspace @wot-av/camera-adapters",
        "test:adapters:portable": "npm run test:portable --workspace @wot-av/camera-adapters",
        "test:adapters:linux": "npm run build:adapters:linux --",
        "test:adapters:definitions": "python -B -m unittest discover -s onvif/tools/tests/adapters/linux -p test_*.py",
        "build:adapters:windows": "npm run build:windows --workspace @wot-av/camera-adapters",
        "build:adapters:linux": "node -e \"if(process.platform!=='linux'){console.error('Linux adapter qualification requires an approved Linux runner; no WSL or service is started.');process.exit(1)}\" && bash onvif/tools/adapters/linux/build-test.sh",
        "check:integration": "python -B av/tools/relocatecheck.py --package",
        "compile:onvif": "npm run compile --workspace @wot-av/binding-onvif",
        "build:onvif": "npm run build --workspace @wot-av/binding-onvif",
        "generate:onvif": "npm run compile:onvif && node onvif/tools/generate-onvif.cjs",
        "generate:onvif:publication": "python -B onvif/tools/generate_onvif.py",
        "verify:onvif:sources": "python -B onvif/tools/fetch_onvif_sources.py --check --scope vendored",
        "validate:onvif": "python -B onvif/tools/validate_onvif.py",
        "pack:onvif": "npm pack --workspace @wot-av/binding-onvif",
        "test:onvif:package": "python -B onvif/tools/pack_onvif.py",
        "test:onvif:ci:offline": "npm run build:onvif && node onvif/tools/tests/reference-runtime/run.cjs unit catalog",
        "test:onvif:ci:loopback": "npm run build:onvif && node onvif/tools/tests/reference-runtime/run.cjs binding-gate events discovery publication media integration",
        "test:onvif:unit": "npm run test:unit --workspace @wot-av/binding-onvif",
        "test:onvif:binding-gate": "npm run test:binding-gate --workspace @wot-av/binding-onvif",
        "test:onvif:integration": "npm run test:integration --workspace @wot-av/binding-onvif",
        "test:onvif:events": "npm run test:events --workspace @wot-av/binding-onvif",
        "test:onvif:discovery": "npm run test:discovery --workspace @wot-av/binding-onvif",
        "test:onvif:publication": "npm run test:publication --workspace @wot-av/binding-onvif",
        "test:onvif:media": "npm run test:media --workspace @wot-av/binding-onvif",
        "test:onvif:media:native": "npm run test:media:native --workspace @wot-av/binding-onvif",
        "test:onvif": "npm test --workspace @wot-av/binding-onvif",
        "test:onvif:catalog": "npm run test:catalog --workspace @wot-av/binding-onvif",
        "test:onvif:all": "npm test --workspace @wot-av/binding-onvif"
    }
}

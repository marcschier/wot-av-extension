# Original unregistered vocabulary: https://example.org/wot/av#
# External context https://example.org/wot/av/context/v0.1 is unhosted.
# Cardinalities and alternative domains are profile requirements, not RDFS inference.
@prefix av: <https://example.org/wot/av#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix td: <https://www.w3.org/2019/wot/td#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

av: a owl:Ontology ; dcterms:created "2026-09-14"^^xsd:date ; dcterms:description "Original proposal. Namespace is unregistered and context URL is unhosted. No deployment, protocol implementation, or certification is asserted."@en ; dcterms:references <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/2020-01-20/>, <https://www.w3.org/TR/2013/REC-prov-o-20130430/>, <https://www.w3.org/TR/2020/REC-json-ld11-20200716/>, <https://www.w3.org/TR/2023/REC-wot-thing-description11-20231205/> ; dcterms:title "Proposed WoT AV vocabulary v0.1"@en ; owl:versionInfo "0.1-proposed" .
av:AAC a rdfs:Resource ; rdfs:comment "AAC family; object type/configuration is required by the pinned decoder configuration."@en ; rdfs:label "AAC"@en .
av:Accepted a rdfs:Resource ; rdfs:comment "Admission succeeded, not readiness."@en ; rdfs:label "Accepted"@en .
av:Active a rdfs:Resource ; rdfs:comment "Desired intent is active, subject to its authoritative current head."@en ; rdfs:label "Active"@en .
av:AgeBudgetUnproven a rdfs:Resource ; rdfs:comment "The worst-case age budget cannot be proved."@en ; rdfs:label "AgeBudgetUnproven"@en .
av:ApplicationIngress a rdfs:Resource ; rdfs:comment "The application receipt boundary for age evaluation."@en ; rdfs:label "ApplicationIngress"@en .
av:ApplicationReady a rdfs:Resource ; rdfs:comment "All required delivered-media predicates have been qualified."@en ; rdfs:label "ApplicationReady"@en .
av:Applying a rdfs:Resource ; rdfs:comment "Applying the accepted configuration/plan."@en ; rdfs:label "Applying"@en .
av:ArtifactFile a rdfs:Resource ; rdfs:comment "A complete artifact file representation, after HTTP content decoding but before media decoding."@en ; rdfs:label "ArtifactFile"@en .
av:Assignment a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "An immutable accepted mapping of one Need revision to selected input/track paths and initial grants. Not a WoT protocol binding or an execution Activity."@en ; rdfs:label "Assignment"@en ; rdfs:subClassOf prov:Entity .
av:AssignmentStatus a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "An immutable observation of an Assignment at a generation and observer-incarnation sequence. Currentness, revocation and head selection must be checked externally."@en ; rdfs:label "AssignmentStatus"@en ; rdfs:subClassOf prov:Entity .
av:AtInstant a rdfs:Resource ; rdfs:comment "One timestamp-selected sample according to the pinned selector profile; end is absent."@en ; rdfs:label "AtInstant"@en .
av:BGR8 a rdfs:Resource ; rdfs:comment "uint8 B,G,R component order; HWC logical geometry; three bytes per pixel."@en ; rdfs:label "BGR8"@en .
av:BackendTrackUnsupported a rdfs:Resource ; rdfs:comment "The chosen adapter cannot deliver the required track."@en ; rdfs:label "BackendTrackUnsupported"@en .
av:BestEffort a rdfs:Resource ; rdfs:comment "Declared drops may occur; no completeness guarantee."@en ; rdfs:label "BestEffort"@en .
av:BlockUpstream a rdfs:Resource ; rdfs:comment "Backpressure only where a qualified upstream can pause or bounded spool proves feasibility."@en ; rdfs:label "BlockUpstream"@en .
av:Bundle a rdfs:Resource ; rdfs:comment "One synchronized group of video units and associated audio blocks."@en ; rdfs:label "Bundle"@en .
av:Byte a rdfs:Resource ; rdfs:comment "One octet of buffered content."@en ; rdfs:label "Byte"@en .
av:Canceled a rdfs:Resource ; rdfs:comment "Execution was canceled."@en ; rdfs:label "Canceled"@en .
av:CapacityExceeded a rdfs:Resource ; rdfs:comment "Qualified bounded capacity is insufficient."@en ; rdfs:label "CapacityExceeded"@en .
av:CaptureAuthorityRequired a rdfs:Resource ; rdfs:comment "Acquisition/configuration authority is not established."@en ; rdfs:label "CaptureAuthorityRequired"@en .
av:CaptureIngress a rdfs:Resource ; rdfs:comment "First captured/acquired units before branch selection."@en ; rdfs:label "CaptureIngress"@en .
av:CaptureTime a rdfs:Resource ; rdfs:comment "Video exposure midpoint, or first audio sample time, when qualified as such."@en ; rdfs:label "CaptureTime"@en .
av:ChoiceConstraint a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Membership in a nonempty set of explicitly supported term/resource IRIs for one supported field. Not a general expression language."@en ; rdfs:label "Choice constraint"@en .
av:Clip a rdfs:Resource ; rdfs:comment "Finite media with a named timeline and full offered extent."@en ; rdfs:label "Clip"@en .
av:ClockUncertain a rdfs:Resource ; rdfs:comment "Clock uncertainty prevents a currentness/validity decision."@en ; rdfs:label "ClockUncertain"@en .
av:ClockUnqualified a rdfs:Resource ; rdfs:comment "The required time basis or common-clock mapping is unqualified."@en ; rdfs:label "ClockUnqualified"@en .
av:ColorConvert a rdfs:Resource ; rdfs:comment "Convert pixel/channel color representation, with qualified colorimetry."@en ; rdfs:label "ColorConvert"@en .
av:CommitTime a rdfs:Resource ; rdfs:comment "Durable result-commit time, not capture time."@en ; rdfs:label "CommitTime"@en .
av:Complete a rdfs:Resource ; rdfs:comment "The declared content/coverage obligation is complete, including a valid empty detection set."@en ; rdfs:label "Complete"@en .
av:Condition a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "One scoped evidence claim, whose four-valued truth state is independent of lifecycle state and digest literals."@en ; rdfs:label "Condition"@en .
av:ConfigureAndCapture a rdfs:Resource ; rdfs:comment "The selected plan needs explicit authority for both the exact configuration and acquisition."@en ; rdfs:label "ConfigureAndCapture"@en .
av:Connector a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "A Thing exposing acquisition or adaptation, including host-local native camera access. Not automatically a sensor or PROV Agent."@en ; rdfs:label "Connector"@en ; rdfs:subClassOf td:Thing .
av:Constant a rdfs:Resource ; rdfs:comment "Exact constant media cadence, requiring frameRate."@en ; rdfs:label "Constant"@en .
av:ContextDocument a rdfs:Resource ; rdfs:comment "A JSON-LD context representation used for semantic interpretation."@en ; rdfs:label "ContextDocument"@en .
av:Contiguous a rdfs:Resource ; rdfs:comment "No inter-row gaps for packed raw images; detailed plane layout remains fixed by pixel format."@en ; rdfs:label "Contiguous"@en .
av:ContractMismatch a rdfs:Resource ; rdfs:comment "Output, model or negotiated media violates the accepted contract."@en ; rdfs:label "ContractMismatch"@en .
av:Controller a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "A Thing exposing coordination interactions through native TD affordances. Its metadata does not implement admission or authority."@en ; rdfs:label "Controller"@en ; rdfs:subClassOf td:Thing .
av:CoveringInterval a rdfs:Resource ; rdfs:comment "May include at most toleranceMs extra media at either edge; no internal omission is authorized."@en ; rdfs:label "CoveringInterval"@en .
av:Decode a rdfs:Resource ; rdfs:comment "Decode an encoded representation."@en ; rdfs:label "Decode"@en .
av:DecodedDelivery a rdfs:Resource ; rdfs:comment "Decoded media immediately before application delivery."@en ; rdfs:label "DecodedDelivery"@en .
av:Degraded a rdfs:Resource ; rdfs:comment "One or more current execution obligations are not met."@en ; rdfs:label "Degraded"@en .
av:DependencyUnavailable a rdfs:Resource ; rdfs:comment "An exact pinned dependency cannot be retrieved."@en ; rdfs:label "DependencyUnavailable"@en .
av:DirectorySnapshot a rdfs:Resource ; rdfs:comment "Exact directory-enriched snapshot, including registration fields and directory-assigned identity."@en ; rdfs:label "DirectorySnapshot"@en .
av:DocumentPin a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "A fixed representation snapshot with retrieval location, exact-octet SHA-256 and provenance scope. dcterms:format/conformsTo describe the pinned content, not the JSON serialization of this descriptive pin record."@en ; rdfs:label "DocumentPin"@en ; rdfs:subClassOf prov:Entity .
av:DomainDocument a rdfs:Resource ; rdfs:comment "A Need, Assignment, status, grant or other domain-record representation."@en ; rdfs:label "DomainDocument"@en .
av:Draining a rdfs:Resource ; rdfs:comment "Owned work is being withdrawn/cleaned up; not proof of cleanup."@en ; rdfs:label "Draining"@en .
av:DropNewest a rdfs:Resource ; rdfs:comment "Discard the incoming unit at this stage."@en ; rdfs:label "DropNewest"@en .
av:DropOldest a rdfs:Resource ; rdfs:comment "Discard the oldest queued unit at this stage."@en ; rdfs:label "DropOldest"@en .
av:DuplicateFrames a rdfs:Resource ; rdfs:comment "Synthesize repeated video frames; cannot be inferred from a rate request."@en ; rdfs:label "DuplicateFrames"@en .
av:EncodedAudio a rdfs:Resource ; rdfs:comment "Codec-encoded audio, distinct from decoded samples."@en ; rdfs:label "EncodedAudio"@en .
av:EncodedBranch a rdfs:Resource ; rdfs:comment "Encoded-media branch after acquisition."@en ; rdfs:label "EncodedBranch"@en .
av:EncodedVideo a rdfs:Resource ; rdfs:comment "Codec-encoded video/image data, distinct from decoded pixels."@en ; rdfs:label "EncodedVideo"@en .
av:Error a rdfs:Resource ; rdfs:comment "A result reports failure rather than successful empty content."@en ; rdfs:label "Error"@en .
av:ExactSamples a rdfs:Resource ; rdfs:comment "Samples whose presentation timestamps lie in [start,end), including audio-sample trimming."@en ; rdfs:label "ExactSamples"@en .
av:Exclusive a rdfs:Resource ; rdfs:comment "No concurrent conflicting allocation in this resource scope."@en ; rdfs:label "Exclusive"@en .
av:F32LE a rdfs:Resource ; rdfs:comment "IEEE 754 binary32 little-endian PCM samples."@en ; rdfs:label "F32LE"@en .
av:Fail a rdfs:Resource ; rdfs:comment "Fail the affected completeness obligation."@en, "Report failure rather than silently continue."@en ; rdfs:label "Fail"@en .
av:Failed a rdfs:Resource ; rdfs:comment "Execution failed."@en, "The attempt failed; recovery requires a new Assignment."@en ; rdfs:label "Failed"@en .
av:False a rdfs:Resource ; rdfs:comment "Evidence establishes the claim does not hold; not merely absent information."@en ; rdfs:label "False"@en .
av:Fault a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "A structured failure with a stable code, non-secret explanation, and optional pinned/identified evidence. Retry and uncertain-effect rules are supplied by the control profile."@en ; rdfs:label "Fault"@en .
av:FormReference a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "An accepted selection of one native Form and one standard TD operation in one pinned TD. An optional JSON Pointer is an explicit selector against those original JSON bytes, never an assumed URI-fragment service."@en ; rdfs:label "FormReference"@en .
av:Frame a rdfs:Resource ; rdfs:comment "One video media unit."@en ; rdfs:label "Frame"@en .
av:FromThing a rdfs:Resource ; rdfs:comment "Media leaves the addressed Thing; xRegistry client-relative usage is consumer."@en ; rdfs:label "FromThing"@en .
av:H264 a rdfs:Resource ; rdfs:comment "ITU-T H.264/AVC family; profile, level and other decoder parameters require the pinned configuration."@en ; rdfs:label "H264"@en .
av:H265 a rdfs:Resource ; dcterms:references <https://www.iana.org/assignments/media-types/video/H265>, <https://www.itu.int/rec/T-REC-H.265-202309-S/en>, <https://www.rfc-editor.org/rfc/rfc7798.html#section-1.1>, <https://www.rfc-editor.org/rfc/rfc7798.html#section-7.1> ; rdfs:comment "ITU-T H.265 / ISO/IEC 23008-2 High Efficiency Video Coding (HEVC) bitstream family, used with EncodedVideo. The exact standard edition, profile, tier, level, compatibility/constraint flags and VPS/SPS/PPS initialization belong to a recognized pinned codec configuration. This is not H.264, a container, RTP packetization or a WebRTC capability claim; the family IRI alone implies no encoding or decoding support."@en ; rdfs:label "H265"@en .
av:HostLocal a rdfs:Resource ; rdfs:comment "Access requires the declared host and native runtime."@en ; rdfs:label "HostLocal"@en .
av:IdempotencyConflict a rdfs:Resource ; rdfs:comment "The same scoped client key was reused with different canonical input."@en ; rdfs:label "IdempotencyConflict"@en .
av:InferenceModel a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/provenance> ; rdfs:comment "A versioned learned-model manifest with verified files, exact tensor/pre/postprocessing/runtime semantics. Neither a WoT Thing Model, JSON Schema, nor xRegistry model."@en ; rdfs:label "InferenceModel"@en ; rdfs:subClassOf prov:Entity .
av:InferenceStart a rdfs:Resource ; rdfs:comment "The beginning of processing/inference for age evaluation."@en ; rdfs:label "InferenceStart"@en .
av:InputAlternative a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "One complete permitted input contract. Its predicates are conjunctive; alternatives are disjunctive, without array-order priority."@en ; rdfs:label "InputAlternative"@en .
av:InputGroup a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "An all-or-none group of at least two Need inputs, optionally synchronized. Groups are disjoint in v0.1; admission atomicity is not physical transaction atomicity."@en ; rdfs:label "InputGroup"@en .
av:InputRequirement a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "One named logical workload input, required or optional, with complete alternatives. A Need may have multiple such inputs."@en ; rdfs:label "Input requirement"@en .
av:InputSelection a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "One accepted logical input, complete alternative, Offer, Mode, adapter configuration and source/sink native Form selections."@en ; rdfs:label "InputSelection"@en .
av:IntegerConstraint a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Inclusive integer bounds on one supported integer field. At least one bound is present; identical bounds express exact equality."@en ; rdfs:label "Integer constraint"@en .
av:IntegrityMismatch a rdfs:Resource ; rdfs:comment "Pinned content or immutable identity has conflicting bytes."@en ; rdfs:label "IntegrityMismatch"@en .
av:Interleaved a rdfs:Resource ; rdfs:comment "Audio channel samples alternate within each sample frame."@en ; rdfs:label "Interleaved"@en .
av:InvalidContract a rdfs:Resource ; rdfs:comment "Invalid syntax, structure, identifier or conditional contract."@en ; rdfs:label "InvalidContract"@en .
av:JPEG a rdfs:Resource ; rdfs:comment "JPEG-coded image data; exact coding variant belongs to the pinned configuration."@en ; rdfs:label "JPEG"@en .
av:LeaseExpired a rdfs:Resource ; rdfs:comment "The applicable enforced grant expired."@en ; rdfs:label "LeaseExpired"@en .
av:LeaseGrant a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "An immutable revision of an externally enforced, single-authority/scope grant. dcterms:isVersionOf is its series; renewal sequence and fencing epoch are distinct."@en ; rdfs:label "LeaseGrant"@en ; rdfs:subClassOf prov:Entity .
av:LeaseRevoked a rdfs:Resource ; rdfs:comment "The applicable enforced grant was revoked."@en ; rdfs:label "LeaseRevoked"@en .
av:Live a rdfs:Resource ; rdfs:comment "Unbounded live media; no invented zero duration."@en ; rdfs:label "Live"@en .
av:ManifestDocument a rdfs:Resource ; rdfs:comment "A typed media/model/result-contract manifest."@en ; rdfs:label "ManifestDocument"@en .
av:MediaAsset a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/provenance> ; rdfs:comment "Sealed retained still or clip content, complete or explicitly partial, described by an exact typed manifest. Not its Offer or storage endpoint."@en ; rdfs:label "MediaAsset"@en ; rdfs:subClassOf prov:Entity .
av:MediaObserved a rdfs:Resource ; rdfs:comment "Selected media samples have actually been observed."@en ; rdfs:label "MediaObserved"@en .
av:MediaSample a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/provenance> ; rdfs:comment "A selected media unit: either derived from a retained asset with a selector, or identified by source, stream incarnation, Track and media-unit sequence. It need not have a media URL."@en ; rdfs:label "MediaSample"@en ; rdfs:subClassOf prov:Entity .
av:MediaSource a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "A physical or logical origin of media, represented as a Thing. Not its media URL or retained content."@en ; rdfs:label "MediaSource"@en ; rdfs:subClassOf td:Thing .
av:MissingTrack a rdfs:Resource ; rdfs:comment "A required logical track cannot be selected."@en ; rdfs:label "MissingTrack"@en .
av:Mode a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "One jointly valid acquisition, native Form, representation, simultaneous track and resource configuration. Track enumeration is complete for this Mode."@en ; rdfs:label "Mode"@en .
av:ModelInput a rdfs:Resource ; rdfs:comment "Model tensor/input queue."@en ; rdfs:label "ModelInput"@en .
av:ModelLoaded a rdfs:Resource ; rdfs:comment "The exact accepted model/files/execution configuration are loaded by the identified processor incarnation."@en ; rdfs:label "ModelLoaded"@en .
av:Mono a rdfs:Resource ; rdfs:comment "One audio channel."@en ; rdfs:label "Mono"@en .
av:Mono8 a rdfs:Resource ; rdfs:comment "One uint8 intensity component per pixel."@en ; rdfs:label "Mono8"@en .
av:Need a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "An immutable desired-intent revision. dcterms:isVersionOf identifies its logical Need and generation orders revisions; current heads are external."@en ; rdfs:label "Need"@en ; rdfs:subClassOf prov:Entity .
av:Network a rdfs:Resource ; rdfs:comment "Access uses a network binding; reachability is still separately proven."@en ; rdfs:label "Network"@en .
av:NoFeasibleAssignment a rdfs:Resource ; rdfs:comment "No complete accepted mapping is feasible."@en ; rdfs:label "NoFeasibleAssignment"@en .
av:NoIntentionalDrop a rdfs:Resource ; rdfs:comment "No planned discard from the named stage through application delivery; not a promise against sensor/network loss."@en ; rdfs:label "NoIntentionalDrop"@en .
av:NoJointMode a rdfs:Resource ; rdfs:comment "No single jointly supported Mode satisfies the alternative."@en ; rdfs:label "NoJointMode"@en .
av:NotApplicable a rdfs:Resource ; rdfs:comment "The obligation is explicitly absent; only allowed by the class-specific lifecycle contract."@en ; rdfs:label "NotApplicable"@en .
av:Observe a rdfs:Resource ; rdfs:comment "No trigger or acquisition-configuration mutation is authorized."@en ; rdfs:label "Observe"@en .
av:Offer a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "A discoverable set of mutually alternative complete Modes from one source, not an endpoint or promise of current availability."@en ; rdfs:label "Offer"@en .
av:OntologyDocument a rdfs:Resource ; rdfs:comment "A vocabulary/ontology representation used for interpretation."@en ; rdfs:label "OntologyDocument"@en .
av:Optional a rdfs:Resource ; rdfs:comment "May be explicitly omitted; if admitted, all its constraints remain hard."@en ; rdfs:label "Optional"@en .
av:Opus a rdfs:Resource ; dcterms:references <https://www.iana.org/assignments/media-types/audio/opus>, <https://www.rfc-editor.org/rfc/rfc6716.html#section-2>, <https://www.rfc-editor.org/rfc/rfc7587.html#section-4.1>, <https://www.rfc-editor.org/rfc/rfc7587.html#section-6.1> ; rdfs:comment "IETF Opus interactive speech and audio coding family defined by RFC 6716, used with EncodedAudio. The exact codec configuration, channel semantics, sampling, framing and negotiated transport parameters belong to recognized pinned codec/binding profiles. This is not PCM, a container or RTP packetization; the family IRI alone implies no encoding, decoding or WebRTC implementation support."@en ; rdfs:label "Opus"@en .
av:OutcomeUncertain a rdfs:Resource ; rdfs:comment "An externally visible effect has an uncertain outcome."@en ; rdfs:label "OutcomeUncertain"@en .
av:PCM a rdfs:Resource ; rdfs:comment "Uncompressed audio samples with explicit sample and buffer formats."@en ; rdfs:label "PCM"@en .
av:Packet a rdfs:Resource ; rdfs:comment "One binding-defined encoded packet, not a decoded frame."@en ; rdfs:label "Packet"@en .
av:Partial a rdfs:Resource ; rdfs:comment "Finalized content is incomplete and has explicit gaps/issues."@en ; rdfs:label "Partial"@en .
av:PayloadDocument a rdfs:Resource ; rdfs:comment "A particular result payload representation."@en ; rdfs:label "PayloadDocument"@en .
av:Planar a rdfs:Resource ; rdfs:comment "Each audio channel occupies its own plane."@en ; rdfs:label "Planar"@en .
av:Preference a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "One Boolean preference goal for an input. Need preference order gives lexicographic ranking after all hard constraints pass."@en ; rdfs:label "Preference"@en .
av:PrerollDecode a rdfs:Resource ; rdfs:comment "Decode/discard prerequisite samples before the selected interval."@en ; rdfs:label "PrerollDecode"@en .
av:PresentationTime a rdfs:Resource ; rdfs:comment "Media presentation timestamp semantics, not automatically UTC."@en ; rdfs:label "PresentationTime"@en .
av:ProcessingRun a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/provenance> ; rdfs:comment "An actual capture, transform, training/export, inference or indexing execution. Use PROV directly for inputs, generation, derivation, responsible agents and execution times."@en ; rdfs:label "ProcessingRun"@en ; rdfs:subClassOf prov:Activity .
av:ProcessingTime a rdfs:Resource ; rdfs:comment "Time at the identified processing boundary."@en ; rdfs:label "ProcessingTime"@en .
av:Processor a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "A Thing offering media processing or receiving input media. Its service identity is distinct from a running holder incarnation."@en ; rdfs:label "Processor"@en ; rdfs:subClassOf td:Thing .
av:ProfileDocument a rdfs:Resource ; rdfs:comment "A recognized versioned operational/configuration profile or specification."@en ; rdfs:label "ProfileDocument"@en .
av:PublisherTD a rdfs:Resource ; rdfs:comment "Exact publisher TD representation; no directory enrichment is silently removed."@en ; rdfs:label "PublisherTD"@en .
av:QueuePolicy a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "A bounded hard policy at one explicitly named processing stage, including overflow and coverage obligations."@en ; rdfs:label "QueuePolicy"@en .
av:QueuePolicyConflict a rdfs:Resource ; rdfs:comment "Queue, overflow, branch-isolation or coverage constraints conflict."@en ; rdfs:label "QueuePolicyConflict"@en .
av:RGB8 a rdfs:Resource ; rdfs:comment "uint8 R,G,B component order; HWC logical geometry; three bytes per pixel."@en ; rdfs:label "RGB8"@en .
av:RangeUnavailable a rdfs:Resource ; rdfs:comment "The requested finite interval is not available."@en ; rdfs:label "RangeUnavailable"@en .
av:Rational a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "An exact reduced numerator/positive-denominator ratio. Units are determined only by the containing predicate."@en ; rdfs:label "Rational"@en .
av:RationalConstraint a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Inclusive exact-rational bounds on a supported rate field. Compare by cross multiplication, never floating-point rounding."@en ; rdfs:label "Rational constraint"@en .
av:RawVideo a rdfs:Resource ; rdfs:comment "Unencoded image pixels with a fixed format and memory layout."@en ; rdfs:label "RawVideo"@en .
av:Ready a rdfs:Resource ; rdfs:comment "Application-ready is true; required model processing additionally needs model-loaded true."@en ; rdfs:label "Ready"@en .
av:ReceiptDocument a rdfs:Resource ; rdfs:comment "An authenticated durable commitment receipt representation."@en ; rdfs:label "ReceiptDocument"@en .
av:ReceiptTime a rdfs:Resource ; rdfs:comment "Time observed at the identified receiver."@en ; rdfs:label "ReceiptTime"@en .
av:ReleaseIncomplete a rdfs:Resource ; rdfs:comment "Cleanup of this Assignment's owned scope is not established."@en ; rdfs:label "ReleaseIncomplete"@en .
av:Released a rdfs:Resource ; rdfs:comment "Authoritative scoped cleanup is evidenced; terminal for this Assignment."@en ; rdfs:label "Released"@en .
av:RemixAudio a rdfs:Resource ; rdfs:comment "Change audio channels/layout."@en ; rdfs:label "RemixAudio"@en .
av:Report a rdfs:Resource ; rdfs:comment "Report incomplete coverage explicitly; not complete success."@en ; rdfs:label "Report"@en .
av:RequestCapture a rdfs:Resource ; rdfs:comment "The selected plan needs authority to request acquisition without changing the selected configuration."@en ; rdfs:label "RequestCapture"@en .
av:Required a rdfs:Resource ; rdfs:comment "Must be admitted and satisfied."@en ; rdfs:label "Required"@en .
av:ResampleAudio a rdfs:Resource ; rdfs:comment "Change audio sample rate."@en ; rdfs:label "ResampleAudio"@en .
av:ResizeCrop a rdfs:Resource ; rdfs:comment "Aspect-preserving resize/crop with a pinned crop rule."@en ; rdfs:label "ResizeCrop"@en .
av:ResizeLetterbox a rdfs:Resource ; rdfs:comment "Aspect-preserving resize/pad with pinned padding, interpolation and rounding."@en ; rdfs:label "ResizeLetterbox"@en .
av:ResizeStretch a rdfs:Resource ; rdfs:comment "Resize without aspect preservation; the profile fixes interpolation and rounding."@en ; rdfs:label "ResizeStretch"@en .
av:ResourceUse a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Use of one shared acquisition/configuration resource in a complete state, with an explicit sharing rule."@en ; rdfs:label "ResourceUse"@en .
av:Result a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/provenance> ; rdfs:comment "An identified output payload under an accepted ResultContract, with explicit completion state, derivation and durable commitment evidence. Its payload is not forced into a universal detection schema."@en ; rdfs:label "Result"@en ; rdfs:subClassOf prov:Entity .
av:ResultCommitFailed a rdfs:Resource ; rdfs:comment "Computation/delivery did not produce a valid durable receipt."@en ; rdfs:label "ResultCommitFailed"@en .
av:ResultCommitted a rdfs:Resource ; rdfs:comment "At least one output under an accepted contract has an identified durable commitment receipt; not all-work-complete."@en ; rdfs:label "ResultCommitted"@en .
av:ResultContract a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/provenance> ; rdfs:comment "A versioned typed contract for a declared output, naming payload schema/dialect/location, meaning, completion rules and native delivery FormReferences in its pinned manifest."@en ; rdfs:label "ResultContract"@en ; rdfs:subClassOf prov:Entity .
av:RevisionConflict a rdfs:Resource ; rdfs:comment "The expected logical Need generation/current head differs."@en ; rdfs:label "RevisionConflict"@en .
av:Running a rdfs:Resource ; rdfs:comment "Actual execution is in progress."@en ; rdfs:label "Running"@en .
av:S16LE a rdfs:Resource ; rdfs:comment "Signed 16-bit little-endian PCM samples."@en ; rdfs:label "S16LE"@en .
av:SameConfiguration a rdfs:Resource ; rdfs:comment "Share only when complete configuration pins identify identical configuration content under the same recognized profile."@en ; rdfs:label "SameConfiguration"@en .
av:SeekSemanticsUnsupported a rdfs:Resource ; rdfs:comment "The selector cannot be implemented with the required boundary semantics."@en ; rdfs:label "SeekSemanticsUnsupported"@en .
av:ShapeDocument a rdfs:Resource ; rdfs:comment "A shape/schema validation representation."@en ; rdfs:label "ShapeDocument"@en .
av:SharedConfigurationConflict a rdfs:Resource ; rdfs:comment "A shared resource has an incompatible complete configuration."@en ; rdfs:label "SharedConfigurationConflict"@en .
av:SkewBudgetUnproven a rdfs:Resource ; rdfs:comment "The worst-case pairwise skew budget cannot be proved."@en ; rdfs:label "SkewBudgetUnproven"@en .
av:StaleObservation a rdfs:Resource ; rdfs:comment "The observation is stale, superseded or belongs to an obsolete incarnation."@en ; rdfs:label "StaleObservation"@en .
av:StereoLR a rdfs:Resource ; rdfs:comment "Two ordered audio channels: left, then right."@en ; rdfs:label "StereoLR"@en .
av:Still a rdfs:Resource ; rdfs:comment "An image-shaped acquisition/access, not necessarily a new exposure."@en ; rdfs:label "Still"@en .
av:Strided a rdfs:Resource ; rdfs:comment "Explicit image plane/row strides are supplied by the qualified configuration."@en ; rdfs:label "Strided"@en .
av:Succeeded a rdfs:Resource ; rdfs:comment "Computation completed successfully, not necessarily result commitment."@en ; rdfs:label "Succeeded"@en .
av:TemporalSubsample a rdfs:Resource ; rdfs:comment "Intentionally select fewer media samples; not queue overflow."@en ; rdfs:label "TemporalSubsample"@en .
av:TimeSelector a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "An instant or half-open interval in one named media timeline, in exact rational seconds. Also describes the full finite extent of an offered Clip."@en ; rdfs:label "TimeSelector"@en .
av:Timestamp a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "An observed instant in rational seconds from one incarnation-specific clock origin, with basis, provenance and optional known uncertainty."@en ; rdfs:label "Timestamp"@en .
av:TimestampMapping a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "A declared mapping capability or actual qualified clock mapping, with time basis, seconds-per-tick and a pinned bounded affine-record profile. It is not itself measured exposure evidence."@en ; rdfs:label "TimestampMapping"@en .
av:TimingConstraint a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "A maximum age or pairwise skew in milliseconds for a stated time basis. An age also states the evaluation stage."@en ; rdfs:label "Timing constraint"@en .
av:ToThing a rdfs:Resource ; rdfs:comment "Media enters the addressed Thing; xRegistry client-relative usage is producer."@en ; rdfs:label "ToThing"@en .
av:Track a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "One named simultaneous media component of a Mode, with one encoded or raw wire representation. Identity is not an SSRC or device index."@en ; rdfs:label "Track"@en .
av:TrackRequirement a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "One logical required or optional track at the wire or delivered boundary. Equal dcterms:identifier values join its wire and delivered contracts within an alternative."@en ; rdfs:label "Track requirement"@en .
av:TrackSelection a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "A mapping of one offered Track to the wire and/or delivered TrackRequirements of one logical track; the qualified adapter configuration supplies the actual boundary signatures."@en ; rdfs:label "TrackSelection"@en .
av:TransformForbidden a rdfs:Resource ; rdfs:comment "The needed operation/preprocessing was not explicitly authorized."@en ; rdfs:label "TransformForbidden"@en .
av:Triggered a rdfs:Resource ; rdfs:comment "Event/trigger-determined cadence, not a constant rate."@en ; rdfs:label "Triggered"@en .
av:True a rdfs:Resource ; rdfs:comment "Positive claim supported by identified evidence."@en ; rdfs:label "True"@en .
av:Unauthorized a rdfs:Resource ; rdfs:comment "Required authorization is absent."@en ; rdfs:label "Unauthorized"@en .
av:Uncertain a rdfs:Resource ; rdfs:comment "An effect may have happened; reconcile rather than blindly repeat."@en ; rdfs:label "Uncertain"@en .
av:Unknown a rdfs:Resource ; rdfs:comment "The claim has not been established either way."@en ; rdfs:label "Unknown"@en .
av:UnknownRequiredFact a rdfs:Resource ; rdfs:comment "Required evidence is unavailable or unknown."@en ; rdfs:label "UnknownRequiredFact"@en .
av:UnreachablePlacement a rdfs:Resource ; rdfs:comment "Host/runtime/reachability constraints fail."@en ; rdfs:label "UnreachablePlacement"@en .
av:UnsupportedProfile a rdfs:Resource ; rdfs:comment "A required binding, configuration or validation profile is not recognized."@en ; rdfs:label "UnsupportedProfile"@en .
av:Variable a rdfs:Resource ; rdfs:comment "Variable media cadence; no exact frameRate is implied."@en ; rdfs:label "Variable"@en .
av:Withdrawn a rdfs:Resource ; rdfs:comment "This immutable revision records withdrawal; no new work is authorized."@en ; rdfs:label "Withdrawn"@en .
av:YUV420P a rdfs:Resource ; rdfs:comment "8-bit planar Y then U then V, 4:2:0 sampling; exact colorimetry and strides require configuration."@en ; rdfs:label "YUV420P"@en .
av:allowedPreprocessing a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Explicitly permitted exact model-preprocessing profile pins, independent of image delivery transforms. Omission or empty means none permitted; a model declaration does not grant permission. Profile uses (alternative domains, not RDFS intersections): av:Need -> av:DocumentPin [0..*]."@en ; rdfs:label "allowedPreprocessing"@en .
av:allowedValues a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Nonempty allowed IRI set for the selected field. Fields with controlled enums restrict values to that enum; host/backend/source/configuration use exact recognized identities/pins. Profile uses (alternative domains, not RDFS intersections): av:ChoiceConstraint -> IRI [1..*]."@en ; rdfs:label "allowedValues"@en .
av:alternative a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Complete permitted alternatives on a requirement; exactly one chosen alternative on an InputSelection. Profile uses (alternative domains, not RDFS intersections): av:InputRequirement -> av:InputAlternative [1..*]; av:InputSelection -> av:InputAlternative [1..1]."@en ; rdfs:label "alternative"@en .
av:assignment a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "Exact immutable accepted attempt whose status or actual processing is described. Profile uses (alternative domains, not RDFS intersections): av:AssignmentStatus -> av:Assignment [1..1]; av:ProcessingRun -> av:Assignment [1..1]."@en ; rdfs:label "assignment"@en .
av:authority a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "External grant enforcer identity. Only its current state and per-effect fencing checks confer authority. Profile uses (alternative domains, not RDFS intersections): av:LeaseGrant -> IRI [1..1]."@en ; rdfs:label "authority"@en .
av:backend a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Qualified native/adapter runtime identity with a versioned capability profile. Profile uses (alternative domains, not RDFS intersections): av:Connector -> IRI [1..1]."@en ; rdfs:label "backend"@en .
av:basis a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Physical/semantic meaning of time, independent of clock unit or mapping availability. Profile uses (alternative domains, not RDFS intersections): av:TimestampMapping -> enum:TimeBasis [1..1]; av:Timestamp -> enum:TimeBasis [1..1]; av:TimingConstraint -> ['av:CaptureTime', 'av:PresentationTime', 'av:ReceiptTime'] [1..1]."@en ; rdfs:label "basis"@en .
av:binding a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Recognized binding specification IRI. Its exact content and dependencies must be pinned at acceptance; this is not native Thing profile conformance and does not by itself assert media flow. Optional on generic Forms; required on media Forms under native_form_rules. Profile uses (alternative domains, not RDFS intersections): hctl:Form -> IRI [0..1]."@en ; rdfs:label "binding"@en .
av:bufferLayout a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Raw-video Contiguous/Strided or PCM Interleaved/Planar memory layout; applicability is representation-specific. Profile uses (alternative domains, not RDFS intersections): av:Track -> enum:BufferLayout [0..1]."@en ; rdfs:label "bufferLayout"@en .
av:cadence a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Offered video cadence semantics. Still omits cadence/frameRate; Constant requires frameRate; Variable/Triggered do not assert an exact rate. Profile uses (alternative domains, not RDFS intersections): av:Track -> enum:Cadence [0..1]."@en ; rdfs:label "cadence"@en .
av:capacity a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Finite positive number of units buffered at the named queue stage; no unbounded sentinel. Profile uses (alternative domains, not RDFS intersections): av:QueuePolicy -> integer [1..1]."@en ; rdfs:label "capacity"@en .
av:captureIntent a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Permitted acquisition effect; grants, control Forms, trigger behavior and uncertain outcomes must still be qualified by the pinned acquisition/control profile. Profile uses (alternative domains, not RDFS intersections): av:InputAlternative -> enum:CaptureIntent [1..1]."@en ; rdfs:label "captureIntent"@en .
av:channelLayout a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Audio channel meaning/order, independent of interleaved/planar storage. Profile uses (alternative domains, not RDFS intersections): av:Track -> enum:ChannelLayout [0..1]."@en ; rdfs:label "channelLayout"@en .
av:channels a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Number of audio channels; Mono requires one and StereoLR two. Fixed unit: channel. Profile uses (alternative domains, not RDFS intersections): av:Track -> integer [0..1]."@en ; rdfs:label "channels"@en .
av:clock a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Named clock/timeline origin and incarnation. Matching names, NTP/PTP labels or RTP clocks alone do not prove synchronization. Profile uses (alternative domains, not RDFS intersections): av:TimestampMapping -> IRI [1..1]; av:Timestamp -> IRI [1..1]; av:TimeSelector -> IRI [1..1]; av:AssignmentStatus -> IRI [1..1]; av:LeaseGrant -> IRI [1..1]."@en ; rdfs:label "clock"@en .
av:code a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "Stable failure IRI from the closed v0.1 failure vocabulary; the control profile fixes action outcomes and retryability. Profile uses (alternative domains, not RDFS intersections): av:Fault -> enum:FaultCode [1..1]."@en ; rdfs:label "code"@en .
av:codec a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Encoded-media codec family; an SDP/JSON Form content type is not a codec claim. Profile uses (alternative domains, not RDFS intersections): av:Track -> enum:Codec [0..1]."@en ; rdfs:label "codec"@en .
av:committedAt a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/provenance> ; rdfs:comment "Durable commitment time established by the authenticated receipt, not capture, computation completion, delivery or subscriber acknowledgment. Profile uses (alternative domains, not RDFS intersections): av:Result -> dateTime [1..1]."@en ; rdfs:label "committedAt"@en .
av:condition a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "Which distinct condition is claimed: media observed, application ready, model loaded, or result committed. Profile uses (alternative domains, not RDFS intersections): av:Condition -> enum:ConditionName [1..1]."@en ; rdfs:label "condition"@en .
av:conditionState a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "Explicit True/False/Unknown/NotApplicable IRI, never JSON false as an unknown sentinel. True requires evidence; false is an actual negative assessment. Profile uses (alternative domains, not RDFS intersections): av:Condition -> enum:TruthState [1..1]."@en ; rdfs:label "conditionState"@en .
av:conditions a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "Exactly one of each of the four distinct Condition names; cardinality alone does not prove their uniqueness or truth. Profile uses (alternative domains, not RDFS intersections): av:AssignmentStatus -> av:Condition [4..4]."@en ; rdfs:label "conditions"@en .
av:configuration a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "One exact typed configuration pin. Mode: acquisition/capture/control/seek profile; Track: codec/layout details; ResourceUse: complete resource state; TimestampMapping: bounded affine records; InputSelection: qualified adapter plan; ProcessingRun: actual execution configuration. Unsupported profiles cannot establish feasibility. Profile uses (alternative domains, not RDFS intersections): av:Mode -> av:DocumentPin [1..1]; av:Track -> av:DocumentPin [0..1]; av:ResourceUse -> av:DocumentPin [1..1]; av:TimestampMapping -> av:DocumentPin [0..1]; av:InputSelection -> av:DocumentPin [1..1]; av:ProcessingRun -> av:DocumentPin [1..1]."@en ; rdfs:label "configuration"@en .
av:connector a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Acquisition/adaptation Thing; required for host-local native-camera sources. Profile uses (alternative domains, not RDFS intersections): av:MediaSource -> av:Connector [0..1]."@en ; rdfs:label "connector"@en .
av:constraints a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Conjunctive typed predicates. Track fields use supported integer/rational/choice constraints; an alternative permits only source/host/backend placement ChoiceConstraints. Profile uses (alternative domains, not RDFS intersections): av:TrackRequirement -> ['av:IntegerConstraint', 'av:RationalConstraint', 'av:ChoiceConstraint'] [0..*]; av:InputAlternative -> av:ChoiceConstraint [0..*]."@en ; rdfs:label "constraints"@en .
av:contract a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Declared, accepted or actually used ResultContract identities. Each accepted declared output needs an exact contract pin in the dependency closure. Profile uses (alternative domains, not RDFS intersections): av:Need -> av:ResultContract [0..*]; av:Assignment -> av:ResultContract [0..*]; av:Result -> av:ResultContract [1..1]."@en ; rdfs:label "contract"@en .
av:coveragePolicy a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Coverage obligation beginning at this queue stage through application delivery, separate from artifact/result completion state. Profile uses (alternative domains, not RDFS intersections): av:QueuePolicy -> enum:CoveragePolicy [1..1]."@en ; rdfs:label "coveragePolicy"@en .
av:deliveredTracks a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Hard application-delivery representation requirements. They do not describe tensors or inherit wire cadence as guaranteed delivered FPS. Profile uses (alternative domains, not RDFS intersections): av:InputAlternative -> av:TrackRequirement [1..*]."@en ; rdfs:label "deliveredTracks"@en .
av:denominator a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Strictly positive exact denominator, reduced with numerator by gcd. The same Rational shape is used everywhere. Profile uses (alternative domains, not RDFS intersections): av:Rational -> integer [1..1]."@en ; rdfs:label "denominator"@en .
av:document a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Explicit effective retrieval IRI for this exact representation. Distinct from Thing id, Form @id and href; preserve it as the base for native relative targets. Do not silently substitute redirects or latest versions. Profile uses (alternative domains, not RDFS intersections): av:DocumentPin -> IRI [1..1]."@en ; rdfs:label "document"@en .
av:documentKind a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Exact provenance/content scope of pinned representation, especially publisher TD versus enriched directory snapshot. Profile uses (alternative domains, not RDFS intersections): av:DocumentPin -> enum:DocumentKind [1..1]."@en ; rdfs:label "documentKind"@en .
av:end a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Exclusive rational end, strictly greater than start; absent for AtInstant. Bounds must lie within the selected finite extent. Fixed unit: second. Profile uses (alternative domains, not RDFS intersections): av:TimeSelector -> av:Rational [0..1]."@en ; rdfs:label "end"@en .
av:evidence a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "Identified support for a claim/fault/timestamp; Result requires a pin of an authenticated durable receipt identifying result, payload digest, contract, run, checked grants and commit scope. Evidence identities are not self-authenticating. Profile uses (alternative domains, not RDFS intersections): av:Condition -> IRI [0..*]; av:Fault -> IRI [0..*]; av:Timestamp -> IRI [1..*]; av:Result -> av:DocumentPin [1..1]."@en ; rdfs:label "evidence"@en .
av:expectedThing a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Expected native TD id, required for any TD pin used by a FormReference. Anonymous legacy TDs need a separately identified and pinned named adapter snapshot. Profile uses (alternative domains, not RDFS intersections): av:DocumentPin -> td:Thing [0..1]."@en ; rdfs:label "expectedThing"@en .
av:fence a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "Monotonic ownership epoch within one authority/scope. Renewal preserves it; reassignment advances it. Do not compare unrelated scopes or assume a fence can recall an issued trigger. Profile uses (alternative domains, not RDFS intersections): av:LeaseGrant -> integer [1..1]."@en ; rdfs:label "fence"@en .
av:field a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "The supported vocabulary property whose value is constrained. Unlisted fields/scripts/coercions are not a v0.1 matcher extension point. Profile uses (alternative domains, not RDFS intersections): av:IntegerConstraint -> enum:IntegerField [1..1]; av:RationalConstraint -> enum:RationalField [1..1]; av:ChoiceConstraint -> enum:ChoiceField [1..1]."@en ; rdfs:label "field"@en .
av:form a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Always the absolute @id of a native TD Form node, never its href. On InputAlternative this is an optional Processor sink Form; acceptance still uses FormReference. Profile uses (alternative domains, not RDFS intersections): av:Mode -> hctl:Form [1..1]; av:InputAlternative -> hctl:Form [0..1]; av:FormReference -> hctl:Form [1..1]."@en ; rdfs:label "form"@en .
av:forms a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "Accepted native interaction selections, including source and optional Processor sink legs. Each is a FormReference, not a duplicate target/transport/security object. Profile uses (alternative domains, not RDFS intersections): av:InputSelection -> av:FormReference [1..*]."@en ; rdfs:label "forms"@en .
av:frameRate a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Exact media cadence at the specified boundary: an offered Track states wire cadence; a TrackRequirement evaluates the wire or retained delivered samples as identified by its containing collection. Never infer delivered cadence from wire cadence after queue loss. This is not wall-clock decoder throughput; an arrival/deadline SLA must additionally fix clock/window semantics in a qualified delivery profile. 30000/1001 is not 30; faster-than-real-time clip processing does not alter media cadence. Fixed unit: frame/media-timeline-second. Profile uses (alternative domains, not RDFS intersections): av:Track -> av:Rational [0..1]."@en ; rdfs:label "frameRate"@en .
av:gapResponse a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Failure/reporting obligation when coverage is incomplete; required for NoIntentionalDrop. Report never means complete success. Profile uses (alternative domains, not RDFS intersections): av:QueuePolicy -> enum:GapResponse [0..1]."@en ; rdfs:label "gapResponse"@en .
av:generation a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Desired Need generation, repeated exactly by its Assignment and observation. Not a directory epoch, lease renewal sequence or fencing token. Profile uses (alternative domains, not RDFS intersections): av:Need -> integer [1..1]; av:Assignment -> integer [1..1]; av:AssignmentStatus -> integer [1..1]."@en ; rdfs:label "generation"@en .
av:goal a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "A delivered TrackRequirement goal named by dcterms:identifier, or source/backend/host ChoiceConstraint. Omitted tracks and unknown facts score false. Profile uses (alternative domains, not RDFS intersections): av:Preference -> ['av:TrackRequirement', 'av:ChoiceConstraint'] [1..1]."@en ; rdfs:label "goal"@en .
av:groups a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Disjoint all-or-none groups. A group containing a required member makes all members required; an all-optional group is admitted entirely or omitted. Profile uses (alternative domains, not RDFS intersections): av:Need -> av:InputGroup [0..*]."@en ; rdfs:label "groups"@en .
av:height a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Actual display/image height in pixels, not sensor maximum or tensor height. Fixed unit: pixel. Profile uses (alternative domains, not RDFS intersections): av:Track -> integer [0..1]."@en ; rdfs:label "height"@en .
av:hexDigest a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Lowercase SHA-256 of the COMPLETE exact representation octets after HTTP content decoding, before parsing or media decoding; no whitespace normalization, field stripping, JCS or RDF canonicalization. Pin is external to covered document. Integrity is not authenticity. Profile uses (alternative domains, not RDFS intersections): av:DocumentPin -> string [1..1]."@en ; rdfs:label "hexDigest"@en .
av:holder a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "Authorized running processor/worker incarnation identity, not merely a service Thing or model file. Profile uses (alternative domains, not RDFS intersections): av:Assignment -> IRI [1..1]; av:LeaseGrant -> IRI [1..1]; av:ProcessingRun -> IRI [1..1]."@en ; rdfs:label "holder"@en .
av:host a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Execution host identity, not device index or network address. HostLocal media Forms require it. Profile uses (alternative domains, not RDFS intersections): av:Connector -> IRI [1..1]; hctl:Form -> IRI [0..1]."@en ; rdfs:label "host"@en .
av:incarnation a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "Observer process or media stream incarnation defining sequence/timestamp scope. Restart/discontinuity requires a new identity; old sequences cannot overwrite current evidence. Profile uses (alternative domains, not RDFS intersections): av:AssignmentStatus -> IRI [1..1]; av:MediaSample -> IRI [0..1]."@en ; rdfs:label "incarnation"@en .
av:input a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Named logical inputs of a Need/group or the input addressed by a preference. All group members belong to the same Need. Profile uses (alternative domains, not RDFS intersections): av:Need -> av:InputRequirement [1..*]; av:InputGroup -> av:InputRequirement [2..*]; av:Preference -> av:InputRequirement [1..1]."@en ; rdfs:label "input"@en .
av:issues a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "Explicit structured problems. A failed/degraded/draining cleanup or incomplete/error result cannot masquerade as successful empty output. Profile uses (alternative domains, not RDFS intersections): av:AssignmentStatus -> av:Fault [0..*]; av:ProcessingRun -> av:Fault [0..*]; av:Result -> av:Fault [0..*]."@en ; rdfs:label "issues"@en .
av:jsonPointer a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Optional RFC 6901 JSON Pointer evaluated against the pinned original JSON representation. If present, it must identify the same named native Form as av:form. Not an automatically supported URI fragment. Profile uses (alternative domains, not RDFS intersections): av:FormReference -> string [0..1]."@en ; rdfs:label "jsonPointer"@en .
av:kind a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Temporal media kind. Still does not imply fresh exposure; Clip requires a finite selector/extent. Profile uses (alternative domains, not RDFS intersections): av:Mode -> enum:MediaKind [1..1]; av:InputAlternative -> enum:MediaKind [1..1]; av:MediaAsset -> ['av:Still', 'av:Clip'] [1..1]."@en ; rdfs:label "kind"@en .
av:lease a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "Externally enforced grant revisions: initial revisions on Assignment, observed currently applicable revisions on status, effect-checked revisions on a run. Renewals do not rewrite prior facts. Profile uses (alternative domains, not RDFS intersections): av:Assignment -> av:LeaseGrant [1..*]; av:AssignmentStatus -> av:LeaseGrant [1..*]; av:ProcessingRun -> av:LeaseGrant [1..*]."@en ; rdfs:label "lease"@en .
av:limitMs a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Maximum age/skew for TimingConstraint, or maximum residence at a QueuePolicy stage. Context fixes which bound; no implicit seconds conversion. Fixed unit: millisecond. Profile uses (alternative domains, not RDFS intersections): av:TimingConstraint -> number [1..1]; av:QueuePolicy -> number [0..1]."@en ; rdfs:label "limitMs"@en .
av:locality a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Access locality. Optional on generic Forms; exactly one is required for media Forms under native_form_rules. Profile uses (alternative domains, not RDFS intersections): hctl:Form -> enum:Locality [0..1]."@en ; rdfs:label "locality"@en .
av:lowerInteger a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Inclusive lower integer bound, in the fixed units of field. Profile uses (alternative domains, not RDFS intersections): av:IntegerConstraint -> integer [0..1]."@en ; rdfs:label "lowerInteger"@en .
av:lowerRational a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Inclusive lower exact-rational bound, in the fixed units of field. Profile uses (alternative domains, not RDFS intersections): av:RationalConstraint -> av:Rational [0..1]."@en ; rdfs:label "lowerRational"@en .
av:maxAge a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Hard worst-case media age at its explicit ApplicationIngress/InferenceStart stage, including all mapped clock uncertainty. Profile uses (alternative domains, not RDFS intersections): av:InputAlternative -> av:TimingConstraint [0..1]."@en ; rdfs:label "maxAge"@en .
av:maxSkew a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Hard worst-case pairwise skew across included tracks or grouped inputs after proven common-domain conversion; compare video time to associated audio first-sample time. Profile uses (alternative domains, not RDFS intersections): av:InputAlternative -> av:TimingConstraint [0..1]; av:InputGroup -> av:TimingConstraint [0..1]."@en ; rdfs:label "maxSkew"@en .
av:mediaDirection a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Media direction relative to the addressed Thing, not request/signaling/session-initiation direction. No universal Both value. Absent on control-only Forms; required for an unambiguously directed media access under native_form_rules. Profile uses (alternative domains, not RDFS intersections): hctl:Form -> enum:MediaDirection [0..1]."@en ; rdfs:label "mediaDirection"@en .
av:mode a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Links complete joint Modes, not independent capability axes. Profile uses (alternative domains, not RDFS intersections): av:Offer -> av:Mode [1..*]; av:InputSelection -> av:Mode [1..1]."@en ; rdfs:label "mode"@en .
av:model a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Exact InferenceModel identity; its complete manifest/files/profiles are pinned independently of native TD/TM versions. Profile uses (alternative domains, not RDFS intersections): av:Need -> av:InferenceModel [0..1]; av:Assignment -> av:InferenceModel [0..1]."@en ; rdfs:label "model"@en .
av:need a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Links a described or accepted immutable Need revision, not its mutable head. Profile uses (alternative domains, not RDFS intersections): td:Thing -> av:Need [0..*]; av:Assignment -> av:Need [1..1]."@en ; rdfs:label "need"@en .
av:numerator a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Signed exact numerator; context requires positivity for rates/time bases and nonnegativity for selectors. Never n, tuple position zero or an anonymous mixed value. Profile uses (alternative domains, not RDFS intersections): av:Rational -> integer [1..1]."@en ; rdfs:label "numerator"@en .
av:observedAt a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "Timestamp when status was observed, with explicit timezone and observation clock. Record publication time may differ. Profile uses (alternative domains, not RDFS intersections): av:AssignmentStatus -> dateTime [1..1]."@en ; rdfs:label "observedAt"@en .
av:offer a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Links an advertised or selected Offer; no copied media address. Profile uses (alternative domains, not RDFS intersections): td:Thing -> av:Offer [0..*]; av:InputSelection -> av:Offer [1..1]."@en ; rdfs:label "offer"@en .
av:omitted a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "Explicit optional omissions, never missing required work. Assignment lists InputRequirement IDs; InputSelection lists omitted wire/delivered TrackRequirement IDs. Profile uses (alternative domains, not RDFS intersections): av:Assignment -> av:InputRequirement [0..*]; av:InputSelection -> av:TrackRequirement [0..*]."@en ; rdfs:label "omitted"@en .
av:operation a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Exactly one existing native TD operation IRI. Resolve native op/defaults in the pinned Form/affordance and require compatibility; serialize native Form op using its standard lowercase TD token, never this AV property. Profile uses (alternative domains, not RDFS intersections): av:FormReference -> enum:NativeOperation [1..1]."@en ; rdfs:label "operation"@en .
av:overflow a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Required reaction at capacity; BlockUpstream needs proven upstream support or bounded spool. Profile uses (alternative domains, not RDFS intersections): av:QueuePolicy -> enum:Overflow [1..1]."@en ; rdfs:label "overflow"@en .
av:pin a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Exact fixed representations: FormReference has one TD pin; DocumentPin lists direct semantic/validation dependencies; Need/Assignment/status close over required records, contexts, profiles and artifacts; MediaAsset/InferenceModel/ResultContract have one recognized typed manifest; Result has its exact payload pin. Profile uses (alternative domains, not RDFS intersections): av:DocumentPin -> av:DocumentPin [0..*]; av:FormReference -> av:DocumentPin [1..1]; av:Need -> av:DocumentPin [0..*]; av:Assignment -> av:DocumentPin [1..*]; av:AssignmentStatus -> av:DocumentPin [0..*]; av:MediaAsset -> av:DocumentPin [1..1]; av:InferenceModel -> av:DocumentPin [1..1]; av:ResultContract -> av:DocumentPin [1..1]; av:Result -> av:DocumentPin [1..1]."@en ; rdfs:label "pin"@en .
av:pixelFormat a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Exact raw-pixel channel order/sample packing; colorimetry, strides and native PFNC mappings require qualified configuration. Profile uses (alternative domains, not RDFS intersections): av:Track -> enum:PixelFormat [0..1]."@en ; rdfs:label "pixelFormat"@en .
av:preferences a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Lexicographically ordered Boolean goals; true before false. Rank only hard-feasible plans, then use stable input/source/mode/plan IDs as a deterministic tie-break. Profile uses (alternative domains, not RDFS intersections): av:Need -> av:Preference [0..*]."@en ; rdfs:label "preferences"@en .
av:presence a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Admission obligation. Optional does not relax predicates after inclusion. Profile uses (alternative domains, not RDFS intersections): av:InputRequirement -> enum:Presence [1..1]; av:TrackRequirement -> enum:Presence [1..1]."@en ; rdfs:label "presence"@en .
av:processor a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Processing service Thing identity, not a loaded model or running instance. Profile uses (alternative domains, not RDFS intersections): av:Need -> av:Processor [1..1]; av:ProcessingRun -> av:Processor [0..1]."@en ; rdfs:label "processor"@en .
av:queues a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Explicit requested per-stage queue policies. The accepted qualified plan must disclose every queue, including internal buffers and pre-branch sharing, even if Need gives no bound. Profile uses (alternative domains, not RDFS intersections): av:InputAlternative -> av:QueuePolicy [0..*]."@en ; rdfs:label "queues"@en .
av:referenceClock a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Target clock of a qualified bounded mapping. Presence requires matching configuration and uncertaintyMs; absence means no common-domain conversion is asserted. Profile uses (alternative domains, not RDFS intersections): av:TimestampMapping -> IRI [0..1]."@en ; rdfs:label "referenceClock"@en .
av:representation a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "One exact encoded/raw representation family. On Track it is wire content; on TrackRequirement it describes the containing wire/delivered boundary. Profile uses (alternative domains, not RDFS intersections): av:Track -> enum:Representation [1..1]; av:TrackRequirement -> enum:Representation [1..1]."@en ; rdfs:label "representation"@en .
av:requirement a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "Requirement discharged by a selection. TrackSelection maps one offered track to one wire and/or one delivered requirement of the same logical name, never two from the same boundary. Wire-only filters are allowed; required coverage, optional omissions and boundary applicability are checked by admission. Profile uses (alternative domains, not RDFS intersections): av:InputSelection -> av:InputRequirement [1..1]; av:TrackSelection -> av:TrackRequirement [1..2]."@en ; rdfs:label "requirement"@en .
av:resource a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "One named resource/fencing configuration domain, not an address. Profile uses (alternative domains, not RDFS intersections): av:ResourceUse -> IRI [1..1]."@en ; rdfs:label "resource"@en .
av:resourceUses a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Complete shared resource/configuration uses of the Mode; admission also checks externally supplied capacities and allocations. Profile uses (alternative domains, not RDFS intersections): av:Mode -> av:ResourceUse [1..*]."@en ; rdfs:label "resourceUses"@en .
av:sampleFormat a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "PCM numeric sample representation; separate from codec identity. Profile uses (alternative domains, not RDFS intersections): av:Track -> enum:SampleFormat [0..1]."@en ; rdfs:label "sampleFormat"@en .
av:sampleRate a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Audio sampling frequency per channel; not bytes/second. Fixed unit: sample/second/channel. Profile uses (alternative domains, not RDFS intersections): av:Track -> integer [0..1]."@en ; rdfs:label "sampleRate"@en .
av:scope a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "One authority-defined fencing/effect domain. Multi-scope assignments require independent current grants, not implied distributed atomicity. Profile uses (alternative domains, not RDFS intersections): av:LeaseGrant -> IRI [1..1]."@en ; rdfs:label "scope"@en .
av:selection a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Exact selector edge/sample semantics. No implied frame-index/FPS conversion, URI fragment support or clip-generation command. Profile uses (alternative domains, not RDFS intersections): av:TimeSelector -> enum:SelectorKind [1..1]."@en ; rdfs:label "selection"@en .
av:selections a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "Accepted mappings: Assignment has InputSelections; each InputSelection has TrackSelections for all included logical tracks. Profile uses (alternative domains, not RDFS intersections): av:Assignment -> av:InputSelection [1..*]; av:InputSelection -> av:TrackSelection [1..*]."@en ; rdfs:label "selections"@en .
av:selector a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Full offered Clip extent on Mode, requested selection on an alternative, or retained/selected-media extent. All values use one named timeline; seeking ability comes only from a recognized configuration. Profile uses (alternative domains, not RDFS intersections): av:Mode -> av:TimeSelector [0..1]; av:InputAlternative -> av:TimeSelector [0..1]; av:MediaAsset -> av:TimeSelector [0..1]; av:MediaSample -> av:TimeSelector [0..1]."@en ; rdfs:label "selector"@en .
av:sequence a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "Nonnegative ordinal within its explicit scope: observer-incarnation/Assignment observations, stream media units, or lease-series renewals. Not a global cursor, packet sequence or fencing token. Profile uses (alternative domains, not RDFS intersections): av:AssignmentStatus -> integer [1..1]; av:MediaSample -> integer [0..1]; av:LeaseGrant -> integer [1..1]."@en ; rdfs:label "sequence"@en .
av:sharing a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Resource sharing requires exact complete-configuration equivalence, not overlapping parameter subsets or similarly named IDs. Profile uses (alternative domains, not RDFS intersections): av:ResourceUse -> enum:Sharing [1..1]."@en ; rdfs:label "sharing"@en .
av:source a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Media source identity; omission on an alternative permits discovery. Profile uses (alternative domains, not RDFS intersections): av:Offer -> av:MediaSource [1..1]; av:InputAlternative -> av:MediaSource [0..1]; av:MediaSample -> av:MediaSource [0..1]."@en ; rdfs:label "source"@en .
av:stage a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Queue boundary or age-evaluation boundary. Not a global drop switch. Profile uses (alternative domains, not RDFS intersections): av:QueuePolicy -> ['av:CaptureIngress', 'av:EncodedBranch', 'av:DecodedDelivery', 'av:ModelInput'] [1..1]; av:TimingConstraint -> ['av:ApplicationIngress', 'av:InferenceStart'] [0..1]."@en ; rdfs:label "stage"@en .
av:start a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Nonnegative rational start/instant from selector clock origin. Fixed unit: second. Profile uses (alternative domains, not RDFS intersections): av:TimeSelector -> av:Rational [1..1]."@en ; rdfs:label "start"@en .
av:state a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Class-specific lifecycle or content state, always an IRI. No direct inference to Condition truth or currentness follows from it. Profile uses (alternative domains, not RDFS intersections): av:Need -> enum:NeedState [1..1]; av:AssignmentStatus -> enum:AssignmentState [1..1]; av:ProcessingRun -> enum:RunState [1..1]; av:MediaAsset -> ['av:Complete', 'av:Partial'] [1..1]; av:Result -> enum:ContentState [1..1]."@en ; rdfs:label "state"@en .
av:time a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Exact observed rational seconds from the stated clock origin. Raw tick/UTC affine conversion and exposure provenance must be retained as evidence; not a datetime-or-integer union. Fixed unit: second. Profile uses (alternative domains, not RDFS intersections): av:Timestamp -> av:Rational [1..1]."@en ; rdfs:label "time"@en .
av:timeBase a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Exact source tick duration; numerator is positive. Mapping configuration fixes affine offset, anchor, bounded tick intervals, drift uncertainty and resets. Fixed unit: second/tick. Profile uses (alternative domains, not RDFS intersections): av:TimestampMapping -> av:Rational [1..1]."@en ; rdfs:label "timeBase"@en .
av:timing a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Track mapping descriptions or actual sample timestamps. A description of mapping capability is not observed timing evidence. Profile uses (alternative domains, not RDFS intersections): av:Track -> av:TimestampMapping [0..*]; av:MediaSample -> av:Timestamp [0..*]."@en ; rdfs:label "timing"@en .
av:toleranceMs a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Maximum permitted excess at each CoveringInterval edge; required only for that selector kind. Fixed unit: millisecond. Profile uses (alternative domains, not RDFS intersections): av:TimeSelector -> number [0..1]."@en ; rdfs:label "toleranceMs"@en .
av:track a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Links offered media Track identities. A TrackRequirement may optionally restrict selection to one exact Track. Profile uses (alternative domains, not RDFS intersections): av:Mode -> av:Track [1..*]; av:TrackRequirement -> av:Track [0..1]; av:TrackSelection -> av:Track [1..1]; av:MediaSample -> av:Track [0..1]."@en ; rdfs:label "track"@en .
av:transformPermissions a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Explicit operations permitted between wire and delivered media. Omitted/empty permits none; queue discards and model preprocessing are governed separately. Profile uses (alternative domains, not RDFS intersections): av:InputAlternative -> enum:Transform [0..*]."@en ; rdfs:label "transformPermissions"@en .
av:uncertaintyMs a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Conservative error bound. Omission means unknown, not zero; mapping scope/validity must be proved by pinned records. Fixed unit: millisecond. Profile uses (alternative domains, not RDFS intersections): av:TimestampMapping -> number [0..1]; av:Timestamp -> number [0..1]; av:AssignmentStatus -> number [0..1]; av:LeaseGrant -> number [0..1]."@en ; rdfs:label "uncertaintyMs"@en .
av:unit a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Queue capacity unit. Fixed-unit physical terms do not take an arbitrary unit field. Profile uses (alternative domains, not RDFS intersections): av:QueuePolicy -> enum:QueueUnit [1..1]."@en ; rdfs:label "unit"@en .
av:upperInteger a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Inclusive upper integer bound, in the fixed units of field; must not be below lowerInteger. Profile uses (alternative domains, not RDFS intersections): av:IntegerConstraint -> integer [0..1]."@en ; rdfs:label "upperInteger"@en .
av:upperRational a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Inclusive upper exact-rational bound, in the fixed units of field; compare to lowerRational by exact cross multiplication. Profile uses (alternative domains, not RDFS intersections): av:RationalConstraint -> av:Rational [0..1]."@en ; rdfs:label "upperRational"@en .
av:validFrom a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "Inclusive grant start on the authority's named, uncertainty-bounded clock. Profile uses (alternative domains, not RDFS intersections): av:LeaseGrant -> dateTime [1..1]."@en ; rdfs:label "validFrom"@en .
av:validUntil a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/lifecycle> ; rdfs:comment "Exclusive freshness/expiry boundary. Status uses [observedAt,validUntil); grant uses [validFrom,validUntil), subject to earlier revocation. Profile uses (alternative domains, not RDFS intersections): av:AssignmentStatus -> dateTime [1..1]; av:LeaseGrant -> dateTime [1..1]."@en ; rdfs:label "validUntil"@en .
av:width a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Actual display/image width in pixels, not sensor maximum, byte stride or tensor width. Fixed unit: pixel. Profile uses (alternative domains, not RDFS intersections): av:Track -> integer [0..1]."@en ; rdfs:label "width"@en .
av:wireTracks a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/module/core> ; rdfs:comment "Additional hard constraints at the negotiated source wire boundary, before decode/conversion/queue loss. Logical track names join to deliveredTracks. Profile uses (alternative domains, not RDFS intersections): av:InputAlternative -> av:TrackRequirement [0..*]."@en ; rdfs:label "wireTracks"@en .

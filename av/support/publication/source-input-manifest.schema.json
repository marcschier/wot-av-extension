{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Producer source input seal",
    "description": "PrivateSourceOnly evidence produced after a successful complete canonical/source and HTML build, never by site staging or committed-snapshot verification.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "classification",
        "inputRulesVersion",
        "sourceDate",
        "producer",
        "assurance",
        "hashAlgorithm",
        "inputs",
        "outputs",
        "digest"
    ],
    "properties": {
        "schemaVersion": {
            "const": 1
        },
        "classification": {
            "const": "PrivateSourceOnly"
        },
        "inputRulesVersion": {
            "const": 1
        },
        "sourceDate": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "producer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "command",
                "specifications",
                "node"
            ],
            "properties": {
                "command": {
                    "const": "npm run build:specs"
                },
                "specifications": {
                    "const": [
                        "av",
                        "onvif"
                    ]
                },
                "node": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                }
            }
        },
        "assurance": {
            "const": "Successful owning canonical generation and HTML rendering; checked snapshots are not an independent render or semantic recompilation."
        },
        "hashAlgorithm": {
            "const": "SHA-256 of exact bytes; digest hashes this four-space LF JSON object without digest. The seal and downstream inventories are not inputs."
        },
        "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/file"
            }
        },
        "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/file"
            }
        },
        "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        }
    },
    "$defs": {
        "file": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "bytes",
                "sha256"
            ],
            "properties": {
                "path": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
                },
                "bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 67108864
                },
                "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                }
            }
        }
    }
}

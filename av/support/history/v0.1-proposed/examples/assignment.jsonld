    "av:authority": "urn:example:av-example:authority",
    "av:scope": "urn:example:av-example:resource:latest-jpeg",
    "av:sequence": 0, "av:fence": 1,
    "av:clock": "urn:example:av-example:clock:authority-fixture",
    "av:validFrom": "2000-01-01T00:00:00Z",
    "av:validUntil": "2000-01-01T00:01:00Z"
  }],
  "av:selections": [{

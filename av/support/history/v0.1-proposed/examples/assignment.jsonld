    "urn:example:av-example:pin:adapter"
  ],
  "av:lease": [{
    "@id": "urn:example:av-example:grant:expired-fixture",
    "@type": "av:LeaseGrant",
    "dcterms:isVersionOf": "urn:example:av-example:grant-series",

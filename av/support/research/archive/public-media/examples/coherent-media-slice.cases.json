      "shape": [
        1,
        3,
        640,
        640
      ],
      "layout": "NCHW",
      "channelOrder": "RGB"
    },
    "preprocess": {
      "from": "BGR8",
      "color": "BGR-to-RGB",
      "resize": {
        "mode": "letterbox",
        "width": 640,
        "height": 640,
        "interpolation": "bilinear",
        "coordinates": "half-pixel",
        "rounding": "nearest-ties-to-even",
        "paddingRgb": [
          114,
          114,
          114
        ]
      },
      "divideBy": 255,
      "to": "float32-NCHW"
    },
    "output": {
      "name": "detections",
      "dtype": "float32",
      "shape": [
        1,
        100,
        6
      ],
      "columns": [
        "x1",
        "y1",
        "x2",
        "y2",
        "score",
        "classId"
      ],
      "coordinates": "letterbox-pixels",
      "suppression": "in-graph"
    },
    "postprocess": {
      "scoreThreshold": 0.25,
      "labels": [
        "part",
        "defect"
      ],
      "clipToImage": true
    },
    "resultSchemaRef": "/schemagroups/vision/schemas/DetectionResult/versions/1"

              "codec": "H264",
              "pixelFormat": "yuv420p",
              "width": 1280,
              "height": 720,
              "rate": {
                "n": 30,
                "d": 1
              }
            },
            "audio": null
          },
          {
            "id": "av720p30",
            "access": "rtspAV",
            "video": {
              "codec": "H264",
              "pixelFormat": "yuv420p",
              "width": 1280,
              "height": 720,
              "rate": {
                "n": 30,
                "d": 1
              }
            },
            "audio": {
              "codec": "AAC",
              "profile": "LC",
              "sampleRateHz": 48000,
              "channels": 1
            }
          }
        ]
      },
      "snapshot": {
        "kind": "still",
        "modes": [
          {
            "id": "jpeg720p",
            "access": "jpeg",
            "video": {
              "codec": "JPEG",
              "width": 1280,
              "height": 720
            },
            "audio": null
          }
        ]
      }

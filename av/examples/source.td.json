{
    "@context": [
        "https://www.w3.org/2022/wot/td/v1.1",
        "https://example.org/wot/av/context/v0.2"
    ],
    "id": "urn:example:av-example:source",
    "@type": [
        "td:Thing"
    ],
    "title": "Illustrative HTTP JPEG source",
    "description": "Publisher-authored hypothetical description, not an observed camera or deployed service. One GET returns one latest-existing JPEG; it does not request a new exposure.",
    "version": {
        "instance": "0.2-proposed"
    },
    "securityDefinitions": {
        "bearer": {
            "scheme": "bearer",
            "in": "header",
            "name": "Authorization",
            "format": "jwt",
            "alg": "ES256"
        }
    },
    "security": [
        "bearer"
    ],
    "av:offer": [
        {
            "@id": "urn:example:av-example:offer:still",
            "@type": "av:Offer",
            "av:source": "urn:example:av-example:source",
            "av:document": "https://media.example.org/source.td.json",
            "av:mode": [
                {
                    "@id": "urn:example:av-example:mode:jpeg720",
                    "@type": "av:Mode",
                    "av:kind": "av:Still",
                    "av:form": "urn:example:av-example:form:snapshot",
                    "av:track": [
                        {
                            "@id": "urn:example:av-example:track:jpeg",
                            "@type": "av:Track",
                            "dcterms:identifier": "picture",
                            "av:representation": "av:EncodedVideo",
                            "av:codec": "av:JPEG",
                            "av:width": 1280,
                            "av:height": 720
                        }
                    ]
                }
            ]
        }
    ],
    "properties": {
        "snapshot": {
            "title": "Latest-existing JPEG",
            "description": "The response is JPEG bytes, not a JSON string or base64 value. Geometry is a publisher-supplied fact about this example output, not a device maximum. Freshness and exposure time are unspecified.",
            "readOnly": true,
            "observable": false,
            "forms": [
                {
                    "@id": "urn:example:av-example:form:snapshot",
                    "@type": "hctl:Form",
                    "href": "https://media.example.org/latest.jpg",
                    "op": "readproperty",
                    "htv:methodName": "GET",
                    "contentType": "image/jpeg",
                    "response": {
                        "contentType": "image/jpeg"
                    }
                }
            ]
        }
    }
}

av: a owl:Ontology ; dcterms:created "2026-09-14"^^xsd:date ; dcterms:description "New local breaking draft. Namespace is unregistered and context is unhosted. No deployment, endorsement, native binding implementation or v0.1 conformance is asserted."@en ; dcterms:references <https://json-schema.org/draft/2020-12/json-schema-core>, <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/2020-01-20/>, <https://www.w3.org/TR/2013/REC-prov-o-20130430/>, <https://www.w3.org/TR/2020/REC-json-ld11-20200716/>, <https://www.w3.org/TR/2023/REC-wot-thing-description11-20231205/> ; dcterms:title "Thin WoT AV vocabulary v0.2"@en ; owl:versionInfo "0.2-proposed" .
av:AAC a rdfs:Resource ; rdfs:comment "AAC encoded-audio family. Native configuration owns object type, initialization and transport parameters; no decoder-support claim."@en ; rdfs:label "AAC"@en .
av:BGR8 a rdfs:Resource ; rdfs:comment "uint8 B,G,R component order; HWC logical geometry; three bytes per pixel."@en ; rdfs:label "BGR8"@en .
av:Clip a rdfs:Resource ; rdfs:comment "The whole finite media item. Native media/container or explicit native interactions own extent and selection; no AV timeline/selector prerequisite."@en ; rdfs:label "Clip"@en .
av:Constant a rdfs:Resource ; rdfs:comment "Exact constant media cadence, requiring frameRate."@en ; rdfs:label "Constant"@en .
av:Contiguous a rdfs:Resource ; rdfs:comment "Packed raw image rows have no inter-row gaps; actual plane layout follows pixel format and native interface."@en ; rdfs:label "Contiguous"@en .
av:EncodedAudio a rdfs:Resource ; rdfs:comment "Codec-encoded audio, distinct from decoded samples."@en ; rdfs:label "EncodedAudio"@en .
av:EncodedVideo a rdfs:Resource ; rdfs:comment "Codec-encoded video/image data, distinct from decoded pixels."@en ; rdfs:label "EncodedVideo"@en .
av:F32LE a rdfs:Resource ; rdfs:comment "IEEE 754 binary32 little-endian PCM samples."@en ; rdfs:label "F32LE"@en .
av:FormReference a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "Selection of a named native Form and standard TD operation in an explicitly located TD document."@en ; rdfs:label "FormReference"@en .
av:H264 a rdfs:Resource ; rdfs:comment "ITU-T H.264/AVC encoded-video family. Native bitstream and negotiation own decoder initialization, profile and level; no decoder-support claim."@en ; rdfs:label "H264"@en .
av:H265 a rdfs:Resource ; dcterms:references <https://www.iana.org/assignments/media-types/video/H265>, <https://www.itu.int/rec/T-REC-H.265-202309-S/en>, <https://www.rfc-editor.org/rfc/rfc7798.html#section-1.1>, <https://www.rfc-editor.org/rfc/rfc7798.html#section-7.1> ; rdfs:comment "ITU-T H.265 / ISO/IEC 23008-2 HEVC encoded-video family. Native bitstream and negotiation own profile, tier, level and initialization; not H264, a container or a WebRTC support claim."@en ; rdfs:label "H265"@en .
av:InputRequirement a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "One named logical workload input with an explicit required/optional inclusion rule and a complete incoming-Mode acceptance schema."@en ; rdfs:label "Input requirement"@en .
av:Interleaved a rdfs:Resource ; rdfs:comment "PCM audio channel samples alternate within each sample frame."@en ; rdfs:label "Interleaved"@en .
av:JPEG a rdfs:Resource ; rdfs:comment "JPEG-coded image family. The actual coding variant and decoding remain native; not raw RGB/BGR pixels."@en ; rdfs:label "JPEG"@en .
av:Live a rdfs:Resource ; rdfs:comment "Open-ended live media. No zero duration, recording extent or delivered-continuity guarantee."@en ; rdfs:label "Live"@en .
av:Mode a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "One jointly offered media-kind, native-Form and complete simultaneous Track combination."@en ; rdfs:label "Mode"@en .
av:Mono a rdfs:Resource ; rdfs:comment "One audio channel."@en ; rdfs:label "Mono"@en .
av:Mono8 a rdfs:Resource ; rdfs:comment "One uint8 intensity component per pixel."@en ; rdfs:label "Mono8"@en .
av:Need a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "An identified desired-work input contract, optionally naming a target processor and declared result access/destination."@en ; rdfs:label "Need"@en .
av:Offer a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "One source Thing's discoverable set of alternative complete media Modes."@en ; rdfs:label "Offer"@en .
av:Optional a rdfs:Resource ; rdfs:comment "The whole input may be left unselected. If selected, every condition of its accepts schema remains hard."@en ; rdfs:label "Optional"@en .
av:Opus a rdfs:Resource ; dcterms:references <https://www.iana.org/assignments/media-types/audio/opus>, <https://www.rfc-editor.org/rfc/rfc6716.html#section-2>, <https://www.rfc-editor.org/rfc/rfc7587.html#section-4.1>, <https://www.rfc-editor.org/rfc/rfc7587.html#section-6.1> ; rdfs:comment "IETF RFC 6716 Opus encoded-audio family. Native configuration and negotiation own framing and transport; not PCM or a guarantee of sample rate, channels or decoder support."@en ; rdfs:label "Opus"@en .
av:PCM a rdfs:Resource ; rdfs:comment "Uncompressed audio samples with explicit sample and buffer formats."@en ; rdfs:label "PCM"@en .
av:Planar a rdfs:Resource ; rdfs:comment "PCM audio channels occupy separate sample planes."@en ; rdfs:label "Planar"@en .
av:RGB8 a rdfs:Resource ; rdfs:comment "uint8 R,G,B component order; HWC logical geometry; three bytes per pixel."@en ; rdfs:label "RGB8"@en .
av:Rational a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "An exact reduced integer numerator and positive integer denominator."@en ; rdfs:label "Rational"@en .
av:RawVideo a rdfs:Resource ; rdfs:comment "Unencoded image pixels with a fixed format and memory layout."@en ; rdfs:label "RawVideo"@en .
av:Required a rdfs:Resource ; rdfs:comment "This whole named input must be selected and satisfy its entire accepts schema; no execution is implied."@en ; rdfs:label "Required"@en .
av:S16LE a rdfs:Resource ; rdfs:comment "Signed 16-bit little-endian PCM samples."@en ; rdfs:label "S16LE"@en .
av:StereoLR a rdfs:Resource ; rdfs:comment "Two ordered audio channels: left, then right."@en ; rdfs:label "StereoLR"@en .
av:Still a rdfs:Resource ; rdfs:comment "One finite image item with one or more image Tracks; no audio, cadence or frameRate. Reading implies neither new exposure nor synchronized capture."@en ; rdfs:label "Still"@en .
av:Strided a rdfs:Resource ; rdfs:comment "Raw image rows or planes use strides. Actual stride values, offsets and memory accessibility remain native and are not implied here."@en ; rdfs:label "Strided"@en .
av:Track a rdfs:Class ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "One named simultaneous encoded or raw component at this Thing's offered interface."@en ; rdfs:label "Track"@en .
av:Triggered a rdfs:Resource ; rdfs:comment "Event/trigger-determined cadence, not a constant rate."@en ; rdfs:label "Triggered"@en .
av:Variable a rdfs:Resource ; rdfs:comment "Variable media cadence; no exact frameRate is implied."@en ; rdfs:label "Variable"@en .
av:YUV420P a rdfs:Resource ; rdfs:comment "8-bit planar Y then U then V, 4:2:0 sampling; exact colorimetry and strides remain native interface facts."@en ; rdfs:label "YUV420P"@en .
av:accepts a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "Requested incoming Mode-description contract at the application's delivered interface. Declared uses (alternative domains, not RDFS intersections): av:InputRequirement -> json [1..1]. Object JSON Schema 2020-12, with only self-contained local references. Explicit $schema may name only that dialect; omission selects that dialect. Hard facts require required. No defaults inject data and format is annotation-only."@en ; rdfs:label "accepts"@en .
av:bufferLayout a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "Image Contiguous/Strided or audio Interleaved/Planar layout category. Declared uses (alternative domains, not RDFS intersections): av:Track -> enum:BufferLayout [0..1]. Required for RawVideo (Contiguous/Strided) or PCM (Interleaved/Planar); otherwise forbidden."@en ; rdfs:label "bufferLayout"@en .
av:cadence a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "Constant, Variable or Triggered observed/offered cadence semantics. Declared uses (alternative domains, not RDFS intersections): av:Track -> enum:Cadence [0..1]. Optional for Live/Clip video; forbidden for Still and audio. Omission is unknown."@en ; rdfs:label "cadence"@en .
av:channelLayout a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "Audio channel meaning and order, independent of storage layout. Declared uses (alternative domains, not RDFS intersections): av:Track -> enum:ChannelLayout [0..1]. Required for audio; Mono/1 and StereoLR/2 are the supported matching pairs. Forbidden for video."@en ; rdfs:label "channelLayout"@en .
av:channels a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "Actual number of media channels. Fixed unit: channels. Declared uses (alternative domains, not RDFS intersections): av:Track -> integer [0..1]. Required for audio; Mono requires 1, StereoLR requires 2. Forbidden for video."@en ; rdfs:label "channels"@en .
av:codec a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "Encoded-media coding family, not signaling contentType or decoder support. Declared uses (alternative domains, not RDFS intersections): av:Track -> enum:Codec [0..1]. Required for EncodedVideo (H264, JPEG, H265) and EncodedAudio (AAC, Opus); forbidden for RawVideo and PCM."@en ; rdfs:label "codec"@en .
av:denominator a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "Strictly positive ratio denominator. Declared uses (alternative domains, not RDFS intersections): av:Rational -> integer [1..1]. Strictly positive and coprime to numerator."@en ; rdfs:label "denominator"@en .
av:destination a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "Requested receiver of the declared result. Declared uses (alternative domains, not RDFS intersections): av:Need -> av:FormReference [0..1]. Requires av:result on the same Need; native processor interaction must separately support the requested sink."@en ; rdfs:label "destination"@en .
av:document a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "Explicit TD retrieval location used to interpret named Forms and native relative targets. Declared uses (alternative domains, not RDFS intersections): av:Offer -> IRI [1..1]; av:FormReference -> IRI [1..1]."@en ; rdfs:label "document"@en .
av:form a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "Absolute @id of the selected native Form, never its href. Declared uses (alternative domains, not RDFS intersections): av:Mode -> IRI [1..1]; av:FormReference -> IRI [1..1]."@en ; rdfs:label "form"@en .
av:frameRate a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "Exact media cadence at this offered interface, not wall-clock throughput or delivered-losslessness SLA. Fixed unit: frames/media-second. Declared uses (alternative domains, not RDFS intersections): av:Track -> av:Rational [0..1]. Required exactly with Constant cadence; otherwise forbidden. Positive, gcd-reduced Rational only."@en ; rdfs:label "frameRate"@en .
av:height a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "Active image-raster rows at the described interface, after codec-mandated conformance cropping for encoded media and before presentation transforms; not coded padding, sensor maximum or tensor height. Fixed unit: pixels. Declared uses (alternative domains, not RDFS intersections): av:Track -> integer [0..1]. Required for EncodedVideo and RawVideo; forbidden for audio."@en ; rdfs:label "height"@en .
av:input a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "Named logical workload inputs. Declared uses (alternative domains, not RDFS intersections): av:Need -> av:InputRequirement [1..*]."@en ; rdfs:label "input"@en .
av:kind a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "Live, Still or whole finite Clip. Declared uses (alternative domains, not RDFS intersections): av:Mode -> enum:MediaKind [1..1]."@en ; rdfs:label "kind"@en .
av:mode a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "Complete jointly offered alternatives. Declared uses (alternative domains, not RDFS intersections): av:Offer -> av:Mode [1..*]."@en ; rdfs:label "mode"@en .
av:need a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "Desired-work contracts associated with an application Thing. Declared uses (alternative domains, not RDFS intersections): td:Thing -> av:Need [0..*]."@en ; rdfs:label "need"@en .
av:numerator a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "Signed ratio numerator; positive at frameRate. Declared uses (alternative domains, not RDFS intersections): av:Rational -> integer [1..1]. Signed on a generic Rational; strictly positive when used as frameRate."@en ; rdfs:label "numerator"@en .
av:offer a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "Advertised complete media alternatives, not copied endpoints. Declared uses (alternative domains, not RDFS intersections): td:Thing -> av:Offer [0..*]."@en ; rdfs:label "offer"@en .
av:operation a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "The selected standard WoT operation. Declared uses (alternative domains, not RDFS intersections): av:FormReference -> enum:NativeOperation [1..1]."@en ; rdfs:label "operation"@en .
av:pixelFormat a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "Actual raw channel order and sample packing. Declared uses (alternative domains, not RDFS intersections): av:Track -> enum:PixelFormat [0..1]. Required only for RawVideo; forbidden for every other representation."@en ; rdfs:label "pixelFormat"@en .
av:presence a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "Required or Optional inclusion of this whole input. Declared uses (alternative domains, not RDFS intersections): av:InputRequirement -> enum:Presence [1..1]."@en ; rdfs:label "presence"@en .
av:processor a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "Requested processing Thing, not a running worker or model artifact. Declared uses (alternative domains, not RDFS intersections): av:Need -> IRI [0..1]."@en ; rdfs:label "processor"@en .
av:representation a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "EncodedVideo, RawVideo, EncodedAudio or PCM at the offered interface. Declared uses (alternative domains, not RDFS intersections): av:Track -> enum:Representation [1..1]."@en ; rdfs:label "representation"@en .
av:result a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "Selected native producer interaction whose DataSchema defines the declared result payload. Declared uses (alternative domains, not RDFS intersections): av:Need -> av:FormReference [0..1]."@en ; rdfs:label "result"@en .
av:sampleFormat a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "PCM numeric sample representation. Declared uses (alternative domains, not RDFS intersections): av:Track -> enum:SampleFormat [0..1]. Required only for PCM; forbidden for every other representation."@en ; rdfs:label "sampleFormat"@en .
av:sampleRate a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "Actual audio sampling frequency per channel. Fixed unit: samples/second/channel. Declared uses (alternative domains, not RDFS intersections): av:Track -> integer [0..1]. Required for EncodedAudio and PCM; forbidden for video."@en ; rdfs:label "sampleRate"@en .
av:source a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "Physical or logical source Thing publishing this Offer. Declared uses (alternative domains, not RDFS intersections): av:Offer -> IRI [1..1]."@en ; rdfs:label "source"@en .
av:track a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "Complete simultaneous components of this Mode. Declared uses (alternative domains, not RDFS intersections): av:Mode -> av:Track [1..*]."@en ; rdfs:label "track"@en .
av:width a rdf:Property ; dcterms:isPartOf <https://example.org/wot/av/0.2/module/core> ; rdfs:comment "Active image-raster columns at the described interface, after codec-mandated conformance cropping for encoded media and before presentation transforms; not coded padding, sensor maximum, stride or tensor width. Fixed unit: pixels. Declared uses (alternative domains, not RDFS intersections): av:Track -> integer [0..1]. Required for EncodedVideo and RawVideo; forbidden for audio."@en ; rdfs:label "width"@en .

{
    "name": "@wot-av/camera-adapters",
    "version": "0.1.0-dev.0",
    "private": true,
    "type": "commonjs",
    "description": "Selected canonical WoT camera semantics over explicit native capture; not an ONVIF SOAP facade",
    "main": "src/index.cjs",
    "types": "src/contract.d.ts",
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "start": "node src/main.cjs",
        "test": "node ../../tools/adapters/run.cjs",
        "test:portable": "node --test ../../tools/tests/adapters/portable.test.cjs",
        "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../tools/adapters/scripts/windows-build.ps1",
        "build:linux": "bash ../../tools/adapters/scripts/linux-build.sh"
    },
    "dependencies": {
        "@node-wot/core": "0.9.2",
        "@node-wot/binding-http": "0.9.2",
        "web-streams-polyfill": "4.3.0",
        "ajv": "8.20.0",
        "ajv-formats": "2.1.1"
    },
    "peerDependencies": {
        "@wot-av/binding-onvif": "0.1.0-dev.0"
    }
}

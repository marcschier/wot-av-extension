+GST_RTSP_API gboolean
+gst_rtsp_connection_set_media_policy (GstRTSPConnection * conn,
+    P0MediaPolicy * policy)
+{
+  GInetAddress *address;
+  GSocketAddress *local;
+  if (!conn || !policy || !policy->authorize || !policy->local_address)
+    return FALSE;
+  address = g_inet_address_new_from_string (policy->local_address);
+  if (!address || g_inet_address_get_is_any (address) ||
+      g_inet_address_get_is_multicast (address)) {
+    g_clear_object (&address);
+    return FALSE;
+  }
+  local = g_inet_socket_address_new (address, 0);
+  g_socket_client_set_local_address (conn->client, local);
+  g_socket_client_set_enable_proxy (conn->client, FALSE);
+  g_object_unref (local);
+  g_object_unref (address);
+  conn->media_policy = policy;
+  return TRUE;
+}

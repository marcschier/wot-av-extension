+GST_RTSP_API gboolean
+gst_rtsp_connection_set_media_auth (GstRTSPConnection * conn,
+    GstRTSPMessage * response)
+{
+  gboolean http = response->type == GST_RTSP_MESSAGE_HTTP_RESPONSE;
+  GHashTable *selected;
+  GHashTable **params;
+  if (!conn || !conn->media_policy)
+    return FALSE;
+  selected = p0_digest_select (response, http ?
+      &conn->media_policy->http : &conn->media_policy->rtsp);
+  if (!selected)
+    return FALSE;
+  params = http ? &conn->media_http_params : &conn->auth_params;
+  g_clear_pointer (params, g_hash_table_unref);
+  *params = selected;
+  return TRUE;
+}

+static gboolean
+gst_rtspsrc_media_control (GstRTSPSrc * src, guint command)
+{
+  gint cmd;
+  if (!g_object_get_data (G_OBJECT (src), "onvif-media-policy"))
+    return FALSE;
+  if (command == 3) {
+    gst_rtspsrc_connection_flush (src, TRUE);
+    return TRUE;
+  }
+  if (command == 2 && src->state == GST_RTSP_STATE_PLAYING)
+    cmd = CMD_PAUSE;
+  else if (command == 1 && (src->state == GST_RTSP_STATE_READY ||
+          src->state == GST_RTSP_STATE_SEEKING))
+    cmd = CMD_PLAY;
+  else
+    return FALSE;
+  /* Let the interrupted receive loop finish its CMD_WAIT before queuing control. */
+  if (gst_rtspsrc_loop_send_cmd (src, CMD_WAIT, CMD_LOOP)) {
+    GST_RTSP_STREAM_LOCK (src);
+    GST_RTSP_STREAM_UNLOCK (src);
+  }
+  gst_rtspsrc_loop_send_cmd (src, cmd, 0);
+  return TRUE;
+}

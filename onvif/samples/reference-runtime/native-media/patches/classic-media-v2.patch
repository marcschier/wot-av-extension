+typedef struct
+{
+  GInetAddress *address;
+  guint16 port;
+  gboolean rejected;
+} MediaUdpPeer;
+
+static void
+media_udp_peer_free (gpointer context)
+{
+  MediaUdpPeer *peer = context;
+  g_object_unref (peer->address);
+  g_free (peer);
+}
+
+static gboolean
+media_udp_buffer_allowed (GstBuffer * buffer, MediaUdpPeer * peer)
+{
+  GstNetAddressMeta *meta = buffer ? gst_buffer_get_net_address_meta (buffer) : NULL;
+  GInetSocketAddress *sender;
+  if (!meta || !G_IS_INET_SOCKET_ADDRESS (meta->addr))
+    return FALSE;
+  sender = G_INET_SOCKET_ADDRESS (meta->addr);
+  return g_inet_socket_address_get_port (sender) == peer->port &&
+      g_inet_address_equal (g_inet_socket_address_get_address (sender), peer->address);
+}
+
+static GstPadProbeReturn
+media_udp_sender_probe (GstPad * pad, GstPadProbeInfo * info, gpointer context)
+{
+  MediaUdpPeer *peer = context;
+  gboolean allowed = TRUE;
+  if (peer->rejected)
+    return GST_PAD_PROBE_DROP;
+  if (GST_PAD_PROBE_INFO_TYPE (info) & GST_PAD_PROBE_TYPE_BUFFER_LIST) {
+    GstBufferList *list = GST_PAD_PROBE_INFO_BUFFER_LIST (info);
+    guint i;
+    allowed = list != NULL;
+    for (i = 0; allowed && i < gst_buffer_list_length (list); ++i)
+      allowed = media_udp_buffer_allowed (gst_buffer_list_get (list, i), peer);
+  } else {
+    allowed = media_udp_buffer_allowed (GST_PAD_PROBE_INFO_BUFFER (info), peer);
+  }
+  if (!allowed) {
+    GstElement *source = gst_pad_get_parent_element (pad);
+    peer->rejected = TRUE;
+    GST_ELEMENT_ERROR (source, RESOURCE, SETTINGS,
+        ("ForbiddenTarget: UDP sender is outside the negotiated native peer policy"),
+        (NULL));
+    gst_object_unref (source);
+    return GST_PAD_PROBE_DROP;
+  }
+  return GST_PAD_PROBE_OK;
+}

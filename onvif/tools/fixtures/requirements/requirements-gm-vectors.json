{
    "schemaVersion": 1,
    "ledger": "bindings/onvif/catalog/requirements-gm.json",
    "purpose": "Declarative, synthetic offline vectors for the G/M requirement inventory and future compiler/runtime assertions. No device, broker, native media session or product-conformance test was run to produce these fixtures.",
    "fixtureBoundary": "Native payload excerpts are identified as excerpts, not complete SOAP messages or a replacement XML-to-JSON binding. Applicability, native-name resolution, semantic expectations and actual runtime evidence are separate.",
    "booleanLexicalCases": [
        {
            "id": "gm.boolean.false",
            "present": true,
            "lexical": "false",
            "expectedState": "known",
            "expectedValue": false
        },
        {
            "id": "gm.boolean.zero",
            "present": true,
            "lexical": "0",
            "expectedState": "known",
            "expectedValue": false
        },
        {
            "id": "gm.boolean.true",
            "present": true,
            "lexical": "true",
            "expectedState": "known",
            "expectedValue": true
        },
        {
            "id": "gm.boolean.one",
            "present": true,
            "lexical": "1",
            "expectedState": "known",
            "expectedValue": true
        },
        {
            "id": "gm.boolean.whitespace",
            "present": true,
            "lexical": " \tfalse\r\n",
            "expectedState": "known",
            "expectedValue": false
        },
        {
            "id": "gm.boolean.missing",
            "present": false,
            "expectedState": "unknown",
            "reason": "No applicable schema default for the capability is supplied."
        },
        {
            "id": "gm.boolean.uppercase-invalid",
            "present": true,
            "lexical": "False",
            "expectedState": "invalid",
            "reason": "Capitalization from prose is not an XML Schema boolean lexical value."
        },
        {
            "id": "gm.boolean.yes-invalid",
            "present": true,
            "lexical": "yes",
            "expectedState": "invalid"
        },
        {
            "id": "gm.boolean.empty-invalid",
            "present": true,
            "lexical": "",
            "expectedState": "invalid"
        },
        {
            "id": "gm.boolean.non-xml-whitespace-invalid",
            "present": true,
            "lexical": "\u00a0false\u00a0",
            "expectedState": "invalid",
            "reason": "Only XML whitespace participates in the boolean whitespace facet."
        }
    ],

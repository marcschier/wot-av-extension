    "logicCases": [
        {
            "id": "gm.logic.not-false",
            "condition": {
                "not": {
                    "fact": "client.feature.videoStreaming",
                    "equals": true
                }
            },
            "facts": {
                "client.feature.videoStreaming": false
            },
            "expected": "true"
        },
        {
            "id": "gm.logic.not-unknown",
            "condition": {
                "not": {
                    "fact": "client.feature.videoStreaming",
                    "equals": true
                }
            },
            "facts": {},
            "expected": "unknown"
        },
        {
            "id": "gm.logic.false-dominates-all",
            "condition": {
                "all": [
                    {
                        "fact": "device.feature.videoStreaming",
                        "equals": true
                    },
                    {
                        "fact": "client.feature.videoStreaming",
                        "equals": true
                    }
                ]
            },
            "facts": {
                "device.feature.videoStreaming": false
            },
            "expected": "false"
        },
        {
            "id": "gm.logic.true-dominates-any",
            "condition": {
                "any": [
                    {
                        "fact": "device.feature.videoStreaming",
                        "equals": true
                    },
                    {
                        "fact": "client.feature.videoStreaming",
                        "equals": true
                    }
                ]
            },
            "facts": {
                "device.feature.videoStreaming": true
            },
            "expected": "true"
        },
        {
            "id": "gm.logic.false-and-missing-any",
            "condition": {
                "any": [
                    {
                        "fact": "device.feature.videoStreaming",
                        "equals": true
                    },
                    {
                        "fact": "client.feature.videoStreaming",
                        "equals": true
                    }
                ]
            },
            "facts": {
                "device.feature.videoStreaming": false
            },
            "expected": "unknown"
        }
    ],

        "libjpeg": "System libjpeg-compatible development files with jpeg_mem_src and jpeg_mem_dest",
        "glibMinimum": "2.52",
        "libusbMinimum": "1.0.16",
        "mesonMinimum": "0.57.0",
        "other": [
            "Linux UAPI headers",
            "pkg-config",
            "GObject",
            "GIO",
            "libxml2",
            "zlib",
            "Ninja",
            "Git"
        ]
    },
    "ubuntuPackages": [
        "build-essential",
        "cmake",
        "pkg-config",
        "libjpeg-dev",
        "libssl-dev",
        "libglib2.0-dev",
        "libxml2-dev",

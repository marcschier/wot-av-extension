        "transformationRegister": "av/support/publication/transformation-register.json",
        "currentInventory": "av/support/publication/integration-result.json",
        "verificationCommand": "python -B av/tools/relocatecheck.py --package",
        "resultOwnership": "The current inventory is generated separately, contains no content hashes of itself, and is excluded from publication-manifest inputs to avoid a proof cycle.",
        "nativeAndExternalGates": "The separate dated Linux software and relocated ONVIF/GStreamer native qualification records report executed passes; definition/source preservation alone is not runtime qualification. All physical hardware, independent external editorial review and release approvals remain unqualified or unapproved."
    },
    "preservedUnownedTrees": [
        "av/support/history",
        "av/support/research",
        "local-only",
        "av/support/upstream/wot",
        "onvif/support/upstream/onvif"
    ],
    "sourceDocuments": "Unchanged ONVIF source/notice bytes are verified against their existing lock, not generated or relicensed. Only the 43 vendored inputs may be copied into the private local tarball.",
